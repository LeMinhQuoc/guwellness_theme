:root {
  --art-title: #000000;
  --art-desc: #000000;
  --art-label-bg: #00A650;
  --art-label-text: #ffffff;
  --border: #DAE0DC;
  --art-hover: #00A650;
  --art-icon: #FFFFFF;
}
.item-article.item-article-style .info-article h4 {
  line-height: 1.35;
  font-size: 22px;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  display: -webkit-box;
  height: 64px;
}
.item-article.item-article-style .info-article h4 a {
  color: var(--art-title);
}
.item-article.item-article-style .info-article h4 a:hover {
  color: var(--art-hover);
}
.item-article.item-article-style .short-article{
  font-size: 16px;
  color: var(--art-desc);
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  display: -webkit-box;
}
.item-article.item-article-style .short-article{-webkit-line-clamp: 3;}
.item-article.item-article-style {
  background-color: white;
  border: 1px solid var(--border);
  position: relative;
  overflow: hidden;
  border-radius: 12px;
}
.item-article.item-article-style .media-article {
  margin: 12px;
      border-radius: 6px;
  position: relative;
  overflow: hidden;
  margin: 0;
}
.item-article.item-article-style .media-article time {
  position: absolute;
  border-radius: 999px;
  top: 8px;
  left: 8px;
  display: inline-block;
  background-color: var(--art-label-bg);
  color: var(--art-label-text);
  padding: 6px 15px; 
  font-size: 12px;
}
.item-article.item-article-style .media-article img.lazyloaded {
  width: 100%;height: 100%;
}
.item-article.item-article-style .info-article {padding: 12px 20px;}
.item-article.item-article-style .view-article {
  margin-top: 20px;
}
.item-article.item-article-style .view-article .button{
  width: 100%;
  padding: 10px 15px;
  background-color: transparent;
  justify-content: start;
  padding: 0;
  color: var(--art-desc);
      text-decoration: underline;
}
.item-article.item-article-style .main-button-text .main-button-icon {
  background-color: var(--art-hover);
  color: var(--art-icon);
}
.item-article.item-article-style .view-article .button:hover{
  color: var(--art-hover);
}
