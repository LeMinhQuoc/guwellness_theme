.cart-page {
	padding: 42px 0 80px;
	color: #151515;
}

.cart-page-heading {
	margin-bottom: 28px;
}

.cart-page-title {
	margin: 0;
	font-size: 40px;
	font-weight: 400;
	line-height: 1.15;
}

.cart-page-count {
	position: relative;
	top: -12px;
	color: #587b3c;
	font-size: 16px;
}

.cart-page-layout {
	display: grid;
	grid-template-columns: minmax(0, 2.05fr) minmax(310px, 1fr);
	gap: 36px;
	align-items: start; 
}

.cart-page-main {
	min-width: 0;
}

.cart-page-reward {
	margin-bottom: 28px;
	background-color: #F5F6EE;
	border-radius: 20px;
	margin-top: 34px;
}

.cart-page-reward-header {
	display: flex;
	align-items: center;
	width: max-content;
	max-width: 100%;
	min-height: 52px;
	padding-left: 20px;
	border-radius: 16px 16px 16px 0;
	background: #78a05e;
	color: #ffffff;
	transform: translateY(calc(-100% + 15px));
    border-radius: 20px 20px 24px 0;
    background: linear-gradient(224deg, #CCDAB9 3.56%, #6F904B 71.86%), linear-gradient(230deg, #FEF8ED 5.95%, #F8EBCC 66.22%);
}

.cart-page-reward-message {
	margin: 0;
	font-size: 16px;
	line-height: 1.4;
	font-weight: 600;
}

.cart-page-reward-link {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	align-self: stretch;
	min-width: 142px;
	margin: 6px;
	margin-left: 18px;
	padding: 0 20px;
	border: 2px solid #55723A;
	border-radius: 24px;
	background: #55723A;
	color: #fff;
	font-size: 18px;
	font-weight: 500;
	font-family: var(--heading-font-family), Georgia, serif;
	transition: background-color 0.2s ease, color 0.2s ease;
}

.cart-page-reward-link:hover {
	background: #587b3c;
	color: #ffffff;
}

.cart-page-reward-button-mobile {
	display: none;
}

.cart-page-reward-body {
	padding: 28px 30px 20px;
}

.cart-page-reward-track {
	position: relative;
	height: 2px;
	margin: 0 20px;
	background: #cedbbf;
}

.cart-page-reward-progress {
	display: block;
	width: 0;
	height: 100%;
	background: #7da05e;
	transition: width 0.4s ease;
}

.cart-page-reward-steps {
	display: flex;
	justify-content: space-between;
	margin-top: -14px;
}

.cart-page-reward-step {
	position: relative;
	z-index: 1;
	display: flex;
	flex: 1 1 0;
	flex-direction: column;
	align-items: center;
	max-width: 190px;
	color: #767a70;
	font-size: 12px;
	line-height: 1.4;
	text-align: center;
}

.cart-page-reward-step:first-child {
	align-items: flex-start;
	text-align: left;
}

.cart-page-reward-step:last-child {
	align-items: flex-end;
	text-align: right;
}

.cart-page-reward-icon {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 30px;
	height: 30px;
	margin-bottom: 7px;
	border-radius: 50%;
	background: #cedbbf;
	color: #ffffff;
}

.cart-page-reward-step.is-active .cart-page-reward-icon {
	background: #7da05e;
}

.cart-page-reward-step strong {
	color: #24271f;
	font-size: 12px;
	font-weight: 600;
}

.cart-page-reward-step small {
	display: block;
	margin-top: 3px;
	font-size: 11px;
}

.cart-page-promotion-app:empty,
.cart-page-promotion-app .hrv-pmo-discount:empty {
	display: none;
}

.cart-page-promotion-app.is-hidden {
	display: none;
}

.cart-page-items {
	display: flex;
	flex-direction: column;
}

.cart-page-item {
	position: relative;
	display: grid;
	grid-template-columns: 146px minmax(0, 1fr);
	gap: 24px;
	min-height: 176px;
	padding: 0 38px 10px 0;
	transition: opacity 0.2s ease;
}

.cart-page-item + .cart-page-item {
	padding-top: 10px;
}

.cart-page-item.mini-cart-item-loading {
	pointer-events: none;
	opacity: 0.5;
}

.cart-page-item-image {
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 146px;
	border-radius: 12px;
	overflow: hidden;
}

.cart-page-item-image > img {
	display: block;
	width: 100%;
	height: auto;
	object-fit: contain;
}

.cart-page-item-gift {
	position: absolute;
	right: 8px;
	bottom: 8px;
	width: 32px;
	height: 32px;
}

.cart-page-item-gift img {
	width: 100%;
	height: 100%;
	object-fit: contain;
}

.cart-page-item-content {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	justify-content: center;
	min-width: 0;
	padding: 18px 0;
}

.cart-page-item-title {
	max-width: 560px;
	margin: 0 0 7px;
	font-size: 16px;
	font-weight: 400;
	line-height: 1.45;
	font-family: var(--base-font), sans-serif;
}

.cart-page-item-title a {
	color: #161616;
}

.cart-page-item-price {
	display: flex;
	align-items: baseline;
	gap: 11px;
	margin-bottom: 13px;
	font-size: 18px;
	line-height: 1.3;
}

.cart-page-item-current-price {
	color: #55723A;
	font-family: var(--heading-font-family), Georgia, serif;
}

.cart-page-item-compare-price {
	color: #737373;
	font-family: var(--heading-font-family), Georgia, serif;
	font-size: 16px;
}

.cart-page-item-controls {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 10px;
}

.cart-page-variants {
	display: flex;
	flex-wrap: wrap;
	gap: 8px;
}

.cart-page-variants.d-none {
	display: none !important;
}

.cart-page-variants .mini-cart-variant {
	position: relative;
	min-width: 132px;
}

.cart-page-variants .mini-cart-variant svg {
	position: absolute;
	top: 50%;
	right: 11px;
	pointer-events: none;
	transform: translateY(-50%);
}

.cart-page-variants .mini-cart-option-select {
	width: 100%;
	height: 40px;
	padding: 0 38px 0 16px;
	border: 0;
	border-radius: 22px;
	outline: 0;
	background: #f7f7f5;
	color: #141414;
	font-size: 13px;
	font-weight: 600;
	appearance: none;
	-webkit-appearance: none;
	cursor: pointer;
}

.cart-page-variants .mini-cart-option-select:disabled {
	cursor: wait;
	opacity: 0.65;
}

.cart-page-quantity {
	display: grid;
	grid-template-columns: 38px 36px 38px;
	align-items: center;
	height: 40px;
	border: 1px solid #292929;
	border-radius: 22px;
	overflow: hidden;
}

.cart-page-quantity-button {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 38px;
	height: 38px;
	padding: 0;
	border: 0;
	background: transparent;
	color: #262626;
	cursor: pointer;
}

.cart-page-quantity-button:disabled {
	cursor: wait;
	opacity: 0.5;
}

.cart-page-quantity-input {
	width: 36px;
	height: 38px;
	padding: 0;
	border: 0;
	outline: 0;
	background: transparent;
	color: #161616;
	font-size: 13px;
	text-align: center;
}

.cart-page-quantity-input.is-app-item {
	width: 50px;
}

.cart-page-item-promotion {
	margin: 8px 0 0;
	color: #587b3c;
	font-size: 12px;
}

.cart-page-item-remove {
	position: absolute;
	top: 12px;
	right: 4px;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 30px;
	height: 30px;
	padding: 0;
	border: 0;
	background: transparent;
	color: #6b6b68;
	cursor: pointer;
	transition: color 0.2s ease;
}

.cart-page-item-remove:hover {
	color: #587b3c;
}

.cart-page-summary {
	position: sticky;
	top: 110px;
}

.cart-page-summary-card {
	padding: 30px 30px 25px;
	border-radius: 20px;
	background: #F5F6EE;
}

.cart-page-summary-title {
	margin: 0 0 25px;
	font-size: 26px;
	font-weight: 400;
	line-height: 1.3;
	text-transform: uppercase;
}

.cart-page-summary-total {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	gap: 16px;
	padding-bottom: 20px;
	border-bottom: 1px solid #d9decf;
	font-size: 16px;
}

.cart-page-summary-total strong {
	color: #587b3c;
	font-size: 25px;
	font-weight: 400;
	white-space: nowrap;
}

.cart-page-terms {
	display: flex;
	align-items: flex-start;
	gap: 10px;
	margin: 28px 0 20px;
	color: #1E293B;
	font-size: 14px;
	line-height: 1.5;
	cursor: pointer;
}

.cart-page-terms input {
	position: absolute;
	width: 1px;
	height: 1px;
	opacity: 0;
}

.cart-page-terms-box {
	display: flex;
	flex: 0 0 18px;
	align-items: center;
	justify-content: center;
	width: 18px;
	height: 18px;
	margin-top: -1px;
	border: 1px solid #d7dbd0;
	background: #ffffff;
	color: transparent;
}

.cart-page-terms input:checked + .cart-page-terms-box {
	border-color: #587b3c;
	background: #587b3c;
	color: #ffffff;
}

.cart-page-terms input:focus-visible + .cart-page-terms-box {
	outline: 2px solid #587b3c;
	outline-offset: 2px;
}

.cart-page-terms a {
	color: #30322e;
	text-decoration: underline;
	text-underline-offset: 2px;
}

.cart-page-terms-error,
.cart-page-minimum-alert {
	display: none;
	margin: -10px 0 14px;
	color: #9f3434;
	font-size: 12px;
	line-height: 1.45;
}

.cart-page-terms-error.is-visible,
.cart-page-minimum-alert {
	display: block;
}

.cart-page-checkout-button {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
	min-height: 43px;
	padding: 10px 20px;
	border-radius: 24px;
	background: #587b3c;
	color: #ffffff;
	font-size: 12px;
	font-weight: 500;
	letter-spacing: 0.02em;
	transition: background-color 0.2s ease, opacity 0.2s ease;
}

.cart-page-checkout-button:hover {
	background: #46642f;
	color: #ffffff;
}

.cart-page-checkout-button.is-terms-disabled,
.cart-page-checkout-button.is-minimum-disabled {
	cursor: not-allowed;
	opacity: 0.72;
}

.cart-page-summary-notes {
	margin: 25px 0 0;
	padding-left: 18px;
	color: #777a73;
	font-size: 14px;
	line-height: 1.6;
	list-style: disc;
}

.cart-page-recommendations {
	margin-top: 54px;
}

.cart-page-recommendations-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 20px;
	margin-bottom: 24px;
}

.cart-page-recommendations-title {
	margin: 0;
	color: #42592f;
	font-family: var(--heading-font-family), Georgia, serif;
	font-size: 34px;
	font-weight: 400;
	line-height: 1.15;
}

.cart-page-recommendations-controls {
	display: flex;
	align-items: center;
	gap: 10px;
	flex: 0 0 auto;
}

.cart-page-recommendations-previous,
.cart-page-recommendations-next {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 34px;
	height: 34px;
	padding: 0;
	border-radius: 50%;
	color: #42592f;
	cursor: pointer;
}

.cart-page-recommendations-previous {
	border: 1px solid #c8d6b5;
	background: #ffffff;
}

.cart-page-recommendations-next {
	border: 1px solid #55723a;
	background: #55723a;
	color: #ffffff;
}

.cart-page-recommendations-previous svg,
.cart-page-recommendations-next svg {
	display: block;
	width: 20px;
	height: 20px;
}

.cart-page-recommendations-previous.swiper-button-disabled,
.cart-page-recommendations-next.swiper-button-disabled {
	opacity: 0.4;
	cursor: default;
}

.cart-page-recommendations-previous.swiper-button-lock,
.cart-page-recommendations-next.swiper-button-lock {
	display: none;
}

.cart-page-recommendations-slider {
	overflow: hidden;
}

.cart-page-recommendations-slide {
	height: auto;
}

.cart-page-recommendations .product-card,
.cart-page-recommendations .product-card-link {
	display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--collection-text);
}

.cart-page-recommendations .product-card__image {
	position: relative;
	overflow: hidden;
	width: 100%;
	aspect-ratio: 1 / 1.3;
	border-radius: 10px;
	background: #f7f6f3;
}

.cart-page-recommendations .product-card__image img {
	display: block;
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.3s ease;
}

.cart-page-recommendations .product-card-link:hover .product-card__image img {
	transform: scale(1.025);
}

.cart-page-recommendations .product-card__body {
	padding: 13px 0 0;
}

.cart-page-recommendations .product-card__title {
	display: -webkit-box;
    min-height: 46px;
    margin: 0;
    overflow: hidden;
    font-family: var(--base-font-family), Arial, sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 23px;
    letter-spacing: -0.2px;
    color: var(--collection-text);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

.cart-page-recommendations .product-card__prices {
	display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 12px;
}

.cart-page-recommendations .product-card__price,
.cart-page-recommendations .product-card__price-old {
    font-family: var(--heading-font-family), Georgia, serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 26px;
    letter-spacing: -1.2px;
    white-space: nowrap;
}

.cart-page-recommendations .product-card__price {
	color: #55723A;
}

.cart-page-recommendations .product-card__price-old {
	color: #737373;
    text-decoration: line-through;
	font-size: 18px;
}

.cart-page-empty {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	min-height: 430px;
	padding: 40px 20px;
	border-radius: 16px;
	background: #f7f8f3;
	text-align: center;
}

.cart-page-empty img {
	width: 190px;
	max-width: 100%;
	height: auto;
	margin-bottom: 22px;
}

.cart-page-empty p {
	margin: 0 0 20px;
	font-size: 16px;
}

.cart-page-empty a {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-width: 180px;
	min-height: 43px;
	padding: 10px 22px;
	border-radius: 24px;
	background: #587b3c;
	color: #ffffff;
	font-size: 13px;
	text-transform: uppercase;
}

@media (max-width: 1199px) {
	.cart-page-layout {
		grid-template-columns: minmax(0, 1.8fr) minmax(300px, 1fr);
		gap: 28px;
	}

	.cart-page-item {
		grid-template-columns: 126px minmax(0, 1fr);
		gap: 20px;
	}

	.cart-page-item-image {
		width: 126px;
	}

	.cart-page-summary-card {
		padding-right: 24px;
		padding-left: 24px;
	}
}

@media (max-width: 991px) {
	.cart-page {
		padding-top: 30px;
	}

	.cart-page-layout {
		grid-template-columns: minmax(0, 1fr);
	}

	.cart-page-summary {
		position: static;
	}
}

@media (max-width: 767px) {
	.cart-page {
		padding: 24px 0 55px;
	}

	.cart-page-heading {
		margin-bottom: 20px;
	}

	.cart-page-title {
		font-size: 30px;
	}

	.cart-page-count {
		top: -8px;
		font-size: 13px;
	}

	.cart-page-reward-header {
		width: 100%;
		min-height: 44px;
		padding-left: 14px;
	}

	.cart-page-reward-message {
		font-size: 12px;
	}

	.cart-page-reward-link {
		min-width: 105px;
		margin-left: auto;
		padding: 0 12px;
		font-size: 11px;
	}

	.cart-page-reward-button-desktop {
		display: none;
	}

	.cart-page-reward-button-mobile {
		display: inline;
	}

	.cart-page-recommendations {
		margin-top: 38px;
	}

	.cart-page-recommendations-header {
		margin-bottom: 18px;
	}

	.cart-page-recommendations-title {
		font-size: 28px;
	}

	.cart-page-recommendations-previous,
	.cart-page-recommendations-next {
		width: 32px;
		height: 32px;
	}

	.cart-page-recommendations .product-card__title,
	.cart-page-recommendations .product-card__price,
	.cart-page-recommendations .product-card__price-old {
		font-size: 13px;
	}

	.cart-page-reward-body {
		padding: 24px 18px 16px;
	}

	.cart-page-item {
		grid-template-columns: 98px minmax(0, 1fr);
		gap: 15px;
		min-height: 142px;
		padding-right: 28px;
	}

	.cart-page-item-image {
		width: 98px;
	}

	.cart-page-item-content {
		padding: 8px 0 14px;
	}

	.cart-page-item-title {
		margin-bottom: 5px;
		font-size: 13px;
	}

	.cart-page-item-price {
		margin-bottom: 10px;
		font-size: 14px;
	}

	.cart-page-item-controls {
		align-items: flex-start;
	}

	.cart-page-variants {
		flex: 1 0 100%;
	}

	.cart-page-variants .mini-cart-variant {
		min-width: 115px;
		max-width: 100%;
	}

	.cart-page-variants .mini-cart-option-select {
		height: 36px;
		padding-left: 13px;
		font-size: 12px;
	}

	.cart-page-quantity {
		grid-template-columns: 34px 32px 34px;
		height: 36px;
	}

	.cart-page-quantity-button,
	.cart-page-quantity-input {
		height: 34px;
	}

	.cart-page-quantity-button {
		width: 34px;
	}

	.cart-page-quantity-input {
		width: 32px;
	}

	.cart-page-item-remove {
		top: 4px;
		right: 0;
	}

	.cart-page-summary-card {
		padding: 24px 20px;
	}

	.cart-page-summary-title {
		font-size: 18px;
	}

	.cart-page-summary-total strong {
		font-size: 22px;
	}
}

@media (max-width: 420px) {
	.cart-page-item {
		grid-template-columns: 82px minmax(0, 1fr);
		gap: 12px;
	}

	.cart-page-item-image {
		width: 82px;
	}

	.cart-page-item-controls {
		gap: 7px;
	}
}
