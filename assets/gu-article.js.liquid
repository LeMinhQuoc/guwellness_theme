/* haravan-audit:v2 */
(function () {
	'use strict';

	function slugify(text) {
		return String(text || '')
			.toLowerCase()
			.replace(/[^\w\u00C0-\u024f\s-]/g, '')
			.trim()
			.replace(/\s+/g, '-');
	}

	function initTableOfContents(root) {
		var content = root.querySelector('[data-gu-article-content]');
		var toc = root.querySelector('[data-gu-toc]');
		var nav = root.querySelector('[data-gu-toc-nav]');
		var toggle = root.querySelector('[data-gu-toc-toggle]');
		if (!content || !toc || !nav || !toggle) return;

		var headings = content.querySelectorAll('h2, h3');
		if (!headings.length) return;

		var list = document.createElement('ol');
		Array.prototype.forEach.call(headings, function (heading, index) {
			if (!heading.id) {
				heading.id = 'gu-heading-' + index + '-' + slugify(heading.textContent);
			}
			var item = document.createElement('li');
			var link = document.createElement('a');
			link.href = '#' + heading.id;
			link.textContent = heading.textContent;
			item.appendChild(link);
			list.appendChild(item);
		});
		nav.appendChild(list);
		toc.hidden = false;

		toggle.addEventListener('click', function () {
			var isOpen = toc.classList.toggle('is-open');
			toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
		});
	}

	function initLatestSlider(root) {
		var section = root.querySelector('[data-gu-article-latest]');
		if (!section || typeof window.Swiper === 'undefined') return;

		var slider = section.querySelector('[data-gu-latest-slider]');
		if (!slider) return;

		new window.Swiper(slider, {
			slidesPerView: 1.25,
			spaceBetween: 20,
			speed: 450,
			loop: false,
			watchOverflow: true,
			navigation: {
				prevEl: section.querySelector('[data-gu-latest-prev]'),
				nextEl: section.querySelector('[data-gu-latest-next]')
			},
			breakpoints: {
				576: {
					slidesPerView: 2,
					spaceBetween: 20
				},
				768: {
					slidesPerView: 3,
					spaceBetween: 20
				},
				992: {
					slidesPerView: 4,
					spaceBetween: 20
				},
				1200: {
					slidesPerView: 5,
					spaceBetween: 20
				}
			}
		});
	}

	function init() {
		var root = document.querySelector('.gu-article');
		if (!root) return;
		initTableOfContents(root);
		initLatestSlider(root);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}
})();
