(function () {
  "use strict";

  var prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var mobileMq = window.matchMedia("(max-width: 991.98px)");

  function isMobileLayout() {
    return mobileMq.matches;
  }

  function setupRevealFallback(items) {
    if (!("IntersectionObserver" in window) || prefersReducedMotion || isMobileLayout()) {
      items.forEach(function (item) {
        item.classList.add("is-visible");
      });
      return;
    }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12 });

    items.forEach(function (el) {
      observer.observe(el);
    });
  }

  function setupReveal() {
    var items = Array.prototype.slice.call(document.querySelectorAll('[data-filename="gu-index-feature-product"] .reveal'));

    if (!items.length) {
      return;
    }

    if (!window.gsap || !window.ScrollTrigger || prefersReducedMotion || isMobileLayout()) {
      setupRevealFallback(items);
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    function refreshScrollTriggers() {
      window.requestAnimationFrame(function () {
        ScrollTrigger.refresh();
        ScrollTrigger.update();

        window.setTimeout(function () {
          ScrollTrigger.refresh();
          ScrollTrigger.update();
        }, 180);
      });
    }

    gsap.utils.toArray(items).forEach(function (el) {
      gsap.fromTo(el,
        { autoAlpha: 0, y: 42 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.85,
          ease: "power3.out",
          scrollTrigger: {
            trigger: el,
            start: "top 82%",
            once: true
          }
        }
      );
    });

    refreshScrollTriggers();

    if (document.readyState === "complete") {
      refreshScrollTriggers();
    } else {
      window.addEventListener("load", refreshScrollTriggers, { once: true });
    }

    window.addEventListener("pageshow", refreshScrollTriggers);
    document.addEventListener("lazyloaded", refreshScrollTriggers);
  }

  document.addEventListener("DOMContentLoaded", setupReveal);
})();
