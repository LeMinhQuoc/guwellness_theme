/* haravan-audit:v2 */
.feature-product {
  position: relative;
  overflow: hidden;
  border-radius: 20px;
}

.feature-product__bg picture,
.feature-product__bg img {
  display: block;
  width: 100%;
  border-radius: 20px;
}

.feature-product__inner {
  position: relative;
  z-index: 1;
  position: absolute;
  top: 0;
  height: 100%;
  display: flex;
  align-items: center;
  padding: 48px;
  width: 100%;
  left: 0;
}

.feature-product__subtitle {
  margin: 0 0 16px;
  font-size: 28px;
  line-height: 30px;
  letter-spacing: -0.5px;
}

.feature-product__title {
  margin: 0 0 40px;
  font-family: var(--gu-font-serif);
  font-size: 56px;
  line-height: 64px;
  letter-spacing: -3px;
}

.feature-product__image {
  max-width: 500px;
  margin: 0 auto;
  border-radius: 16px;
  overflow: hidden;
}

.gu-btn {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  color: var(--gu-white);
  border: 0;
  background: transparent;
  cursor: pointer;
  user-select: none;
}

.gu-btn__icon,
.gu-btn__label {
  display: inline-flex;
  align-items: center;
  height: 40px;
  background: var(--gu-green);
}

.gu-btn__icon {
  justify-content: center;
  width: 40px;
  margin-right: -1px;
  border-radius: 50%;
  flex-shrink: 0;
}

.gu-btn__label {
  padding: 0 20px;
  border-radius: 999px;
  font-family: var(--gu-font-serif);
  font-size: 18px;
  line-height: 1;
  letter-spacing: -0.2px;
  text-transform: uppercase;
}

@media (max-width: 991.98px) {
  .feature-product__bg img {
    min-height: 570px;
  }
  .feature-product {
    min-height: 0;
  }

  .feature-product__inner {
    padding-top: 80px;
    padding-bottom: 80px;
  }
  .feature-product__image {
    margin-top: 40px;
  }
}

@media (max-width: 575.98px) {
  .feature-product__title {
    font-size: 36px;
    line-height: 1.08;
    letter-spacing: -1.6px;
  }
}
