/* haravan-audit:v2 */
.section-title {
  margin: 0;
  font-family: var(--gu-font-serif);
  font-size: 56px;
  line-height: 64px;
  letter-spacing: -3px;
}

.partner__text {
  flex: 0 0 544px;
}

.partner__copy {
  max-width: 464px;
  margin: 12px 0 40px;
  font-size: 24px;
  line-height: 1.35;
  letter-spacing: -0.5px;
}

.partner__image {
  border-radius: 16px;
  overflow: hidden;
}

.partner__image img {
  max-height: 420px;
}

.gu-btn {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  color: var(--gu-white);
  border: 0;
  background: transparent;
  cursor: pointer;
  user-select: none;
}

.gu-btn__icon,
.gu-btn__label {
  display: inline-flex;
  align-items: center;
  height: 40px;
  background: var(--gu-green);
}

.gu-btn__icon {
  justify-content: center;
  width: 40px;
  margin-right: -1px;
  border-radius: 50%;
  flex-shrink: 0;
}

.gu-btn__label {
  padding: 0 20px;
  border-radius: 999px;
  font-family: var(--gu-font-serif);
  font-size: 18px;
  line-height: 1;
  letter-spacing: -0.2px;
  text-transform: uppercase;
}

@media (max-width: 991.98px) {
  .partner__text {
    flex-basis: auto;
  }

  .partner__image img {
    max-height: none;
  }
}

@media (max-width: 575.98px) {
  .section-title {
    font-size: 36px;
    line-height: 1.08;
    letter-spacing: -1.6px;
  }
}
