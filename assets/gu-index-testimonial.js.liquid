/* haravan-audit:v2 */
(function () {
  "use strict";

  var prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var mobileMq = window.matchMedia("(max-width: 991.98px)");

  function isMobileLayout() {
    return mobileMq.matches;
  }

  function setupRevealFallback(items) {
    if (!("IntersectionObserver" in window) || prefersReducedMotion || isMobileLayout()) {
      items.forEach(function (item) {
        item.classList.add("is-visible");
      });
      return;
    }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12 });

    items.forEach(function (el) {
      observer.observe(el);
    });
  }

  function setupReveal() {
    var items = Array.prototype.slice.call(document.querySelectorAll('[data-filename="gu-index-testimonial"] .reveal'));

    if (!items.length) {
      return;
    }

    if (!window.gsap || !window.ScrollTrigger || prefersReducedMotion || isMobileLayout()) {
      setupRevealFallback(items);
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    gsap.utils.toArray(items).forEach(function (el) {
      gsap.fromTo(el,
        { autoAlpha: 0, y: 42 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.85,
          ease: "power3.out",
          scrollTrigger: {
            trigger: el,
            start: "top 82%",
            once: true
          }
        }
      );
    });
  }

  function setupVideos() {
    var sections = Array.prototype.slice.call(document.querySelectorAll('[data-filename="gu-index-testimonial"]'));

    sections.forEach(function (section) {
      var cards = Array.prototype.slice.call(section.querySelectorAll("[data-testimonial-video]"));

      function resetCard(card) {
        var video = card.querySelector("video");
        var button = card.querySelector("[data-testimonial-play]");

        if (!video) return;

        video.pause();
        video.currentTime = 0;
        card.classList.remove("is-playing");

        if (button) {
          button.setAttribute("aria-label", "Phát video đánh giá");
          button.setAttribute("aria-pressed", "false");
        }
      }

      function resetOtherCards(activeCard) {
        cards.forEach(function (card) {
          if (card !== activeCard) resetCard(card);
        });
      }

      function pauseCard(card) {
        var video = card.querySelector("video");

        if (video) video.pause();
      }

      function pauseOtherCards(activeCard) {
        cards.forEach(function (card) {
          if (card !== activeCard) pauseCard(card);
        });
      }

      function playCard(card, withSound) {
        var video = card.querySelector("video");
        var button = card.querySelector("[data-testimonial-play]");

        if (!video) return;

        if (withSound) {
          resetOtherCards(card);
        } else {
          pauseOtherCards(card);
        }
        video.muted = !withSound;
        card.classList.add("is-playing");

        if (button) {
          button.setAttribute("aria-label", "Tạm dừng video đánh giá");
          button.setAttribute("aria-pressed", "true");
        }

        var playPromise = video.play();

        if (playPromise && typeof playPromise.catch === "function") {
          playPromise.catch(function () {
            resetCard(card);
          });
        }
      }

      cards.forEach(function (card) {
        var video = card.querySelector("video");
        var button = card.querySelector("[data-testimonial-play]");

        if (!video) return;

        card.addEventListener("mouseenter", function () {
          if (!isMobileLayout()) playCard(card, false);
        });

        card.addEventListener("mouseleave", function () {
          if (!isMobileLayout()) pauseCard(card);
        });

        if (button) {
          button.addEventListener("click", function () {
            if (!isMobileLayout()) return;

            if (video.paused) {
              playCard(card, true);
            } else {
              resetCard(card);
            }
          });
        }

        video.addEventListener("ended", function () {
          resetCard(card);
        });
      });

      function resetAllCards() {
        cards.forEach(resetCard);
      }

      if (typeof mobileMq.addEventListener === "function") {
        mobileMq.addEventListener("change", resetAllCards);
      } else if (typeof mobileMq.addListener === "function") {
        mobileMq.addListener(resetAllCards);
      }

      document.addEventListener("visibilitychange", function () {
        if (document.hidden) resetAllCards();
      });
    });
  }

  document.addEventListener("DOMContentLoaded", function () {
    setupReveal();
    setupVideos();
  });
})();
