.contact-icons {
	position: fixed;
	z-index: 990;
	right: 22px;
	bottom: 132px;
	width: 56px;
	height: 56px;
}

.contact-icons-launcher {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 56px;
	height: 56px;
	padding: 0;
	border: 0;
	border-radius: 50%;
	background: var(--gu-green, #55723a);
	box-shadow: 0 7px 18px rgba(42, 61, 30, 0.22);
	color: #ffffff;
	cursor: pointer;
	opacity: 1;
	visibility: visible;
	transform: scale(1);
	transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
}

.contact-icons-launcher:hover {
	color: #ffffff;
	transform: translateY(-2px);
}

.contact-icons-launcher:focus-visible,
.contact-icons-close:focus-visible,
.contact-icons-item:focus-visible {
	outline: 2px solid #202020;
	outline-offset: 3px;
}

.contact-icons-list {
	position: absolute;
	right: 8px;
	bottom: 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 8px;
	min-width: 40px;
	padding: 0;
	border-radius: 0;
	background: transparent;
	box-shadow: none;
	opacity: 0;
	visibility: hidden;
	pointer-events: none;
	transform: translateY(10px) scale(0.94);
	transform-origin: center bottom;
	transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
}

.contact-icons-item {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 40px;
	height: 40px;
	border-radius: 50%;
	color: #ffffff;
	transition: transform 0.16s ease, opacity 0.16s ease;
}

.contact-icons-item:hover {
	color: #ffffff;
	transform: scale(1.08);
}

.contact-icons-item[aria-disabled="true"] {
	cursor: default;
}

.contact-icons-custom-image {
	display: block;
	width: 40px;
	height: 40px;
	border-radius: 50%;
	object-fit: contain;
}

.contact-icons-phone {
	background: transparent;
}

.contact-icons-phone svg {
	display: block;
	width: 40px;
	height: 40px;
}

.contact-icons-facebook {
	background: #1877f2;
}

.contact-icons-zalo,
.contact-icons-messenger {
	background: transparent;
}

.contact-icons-zalo svg,
.contact-icons-messenger svg {
	display: block;
	width: 40px;
	height: 40px;
}

.contact-icons-item.contact-icons-item-custom {
	background: transparent;
}

.contact-icons-close {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 30px;
	height: 30px;
	margin-top: 0;
	padding: 3px;
	border: 0;
	border-radius: 4px;
	background: #ffffff;
	color: #0a0a0a;
	box-shadow: 0 24px 24px rgba(16, 24, 40, 0.18);
	cursor: pointer;
}

.contact-icons-open .contact-icons-launcher {
	opacity: 0;
	visibility: hidden;
	pointer-events: none;
	transform: scale(0.8);
}

.contact-icons-open .contact-icons-list {
	opacity: 1;
	visibility: visible;
	pointer-events: auto;
	transform: translateY(0) scale(1);
}