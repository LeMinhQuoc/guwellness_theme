#hrv-pagination {
    --page-color: {{settings.shop_main_color}};
      margin: 60px 0 15px;
      .hrv-pagination {
          margin: 0;padding: 0;justify-content: center;-webkit-justify-content: center;
      svg {
        width: 22px;
        height: 22px;
      }
          >li {
              display: inline-block;
              vertical-align: middle;
              &:not(:last-child) {margin-right: 8px;}
              >span,a{
                  position: relative;
                  float: left;
                  line-height: 33px;
                  text-decoration: none;
                  color: #333e48;
                  background-color: #fff;
                  border: 1px solid #dee2e6;
                  width: 35px;
                  height: 35px;
                  text-align: center;
                  border-radius: 0 !important;
                  font-weight: 600;
                  padding: 0;
                  cursor: pointer;
                  &.current{
                      background-color: var(--page-color);
                      border-color: var(--page-color);
                      color: #fff;
                  }
              }
              >a:hover,>a:focus,>span:hover,>span:focus{
                  z-index: 2;
                  color: #fff;
                  background-color: var(--page-color);
                  border-color: var(--page-color);
              }
          }
      }
  }
  