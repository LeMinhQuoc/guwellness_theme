function createIngredientScroll() {
  const section = $(".ingredient-section");
  const map = $(".map-card");
  const heading = $(".ingredient-content h2");
  const cards = $$(".ingredient-cards article");
  const cardImages = $$(".ingredient-cards article img");

  if (!section || !map || !heading) return;

  gsap.set(map, { transformOrigin: "top center", x: 0, y: 0, scale: 1 });
  gsap.set(cards, { autoAlpha: 0, y: 80 });
  gsap.set(cardImages, { scale: 0.9 });

  let cachedMapStart = null;
  const readMapStart = () => {
    const currentTransform = map.style.transform;
    map.style.transform = "none";
    const rect = map.getBoundingClientRect();
    const shellRect = $(".ingredient-shell").getBoundingClientRect();
    map.style.transform = currentTransform;
    const targetCenterX = rect.left + rect.width / 2;
    const viewportCenterX = window.innerWidth / 2;
    const navOffset = 90;
    const scale = Math.min(
      (shellRect.width - 64) / rect.width,
      ((window.innerHeight - navOffset) * 0.98) / rect.height,
      1.28
    );

    return {
      x: viewportCenterX - targetCenterX,
      scale,
    };
  };
  const getMapStart = () => {
    cachedMapStart ||= readMapStart();
    return cachedMapStart;
  };

  const tl = gsap.timeline({
    defaults: { ease: "none" },
    scrollTrigger: {
      trigger: section,
      start: "top top+=90",
      end: "+=1000",
      scrub: 0.4,
      pin: true,
      anticipatePin: 1,
      invalidateOnRefresh: true,
      onRefreshInit: () => {
        cachedMapStart = null;
        gsap.set(map, { x: 0, y: 0, scale: 1 });
      },
    },
  });

  tl.fromTo(
    map,
    {
      x: () => getMapStart().x,
      y: 0,
      scale: () => getMapStart().scale,
    },
    { x: 0, y: 0, scale: 1 },
    0
  )
    .fromTo(heading, { autoAlpha: 0, y: 30 }, { autoAlpha: 1, y: 0, duration: 0.22 }, 0.14)
    .to(cards, { autoAlpha: 1, y: 0, duration: 0.25, stagger: 0.08 }, 0.3)
    .to(cardImages, { scale: 1, duration: 0.25, stagger: 0.08 }, 0.32);
}

