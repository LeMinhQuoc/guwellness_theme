function createMobileMotion() {
  gsap.set(".hero-fullscreen-stage", { autoAlpha: 0 });
  setVisible(".hero-image img");
  setVisible(".hero-copy, .hero-copy > *");

  gsap.from(".hero-copy > *", {
    autoAlpha: 0,
    y: 28,
    duration: 0.8,
    ease: "power3.out",
    stagger: 0.1,
  });

  const targets = $$(".origin-copy h2, .question-card, .ingredient-content h2, .ingredient-cards article, .realization h2, .philosophy-heading > *, .glass-grid article, .mission-vision article, .value-list article, .team-grid article, .timeline-list article, .sustain-list article, .community-cards article, .contact article");
  gsap.set(targets, { autoAlpha: 0, y: 34 });

  const revealBatch = (batch) => {
    gsap.to(batch, {
      autoAlpha: 1,
      y: 0,
      duration: 0.7,
      ease: "power3.out",
      stagger: 0.05,
      overwrite: true,
    });
  };

  const revealReachedTargets = () => {
    const reachedTargets = targets.filter((target) => target.getBoundingClientRect().top < window.innerHeight);
    if (reachedTargets.length) setVisible(reachedTargets);
  };

  ScrollTrigger.batch(targets, {
    start: "top 83%",
    interval: 0.08,
    batchMax: 4,
    onEnter: revealBatch,
    onEnterBack: revealBatch,
  });

  let syncFrame;
  const syncRestoredScroll = () => {
    cancelAnimationFrame(syncFrame);
    syncFrame = requestAnimationFrame(() => {
      revealReachedTargets();
      ScrollTrigger.refresh();
    });
  };

  syncRestoredScroll();
  window.addEventListener("load", syncRestoredScroll);
  window.addEventListener("pageshow", syncRestoredScroll);

  return () => {
    cancelAnimationFrame(syncFrame);
    window.removeEventListener("load", syncRestoredScroll);
    window.removeEventListener("pageshow", syncRestoredScroll);
  };
}

function reducedMotionFallback() {
  motionRoot.classList.add("is-reduced-motion");
  gsap.set(".hero-fullscreen-stage", { display: "none" });
  setVisible("*");
}

function initMotion() {
  if (!window.gsap || !window.ScrollTrigger) {
    console.warn("GSAP or ScrollTrigger failed to load; static layout is still available.");
    return;
  }

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({
    ignoreMobileResize: true,
    limitCallbacks: true,
  });
  motionRoot.classList.add("motion-ready");

  const mm = gsap.matchMedia();

  mm.add("(prefers-reduced-motion: reduce)", reducedMotionFallback);

  mm.add("(min-width: 1200px) and (prefers-reduced-motion: no-preference)", () => {
    //createHeroScroll();
    createOriginScroll();
    createIngredientScroll();
    createSectionMotion();
    createCollabScroll();
  });

  mm.add("(max-width: 1199px) and (prefers-reduced-motion: no-preference)", createMobileMotion);

  window.addEventListener("load", () => requestAnimationFrame(() => ScrollTrigger.refresh()));
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(() => ScrollTrigger.refresh());
  }
}

if (pageAboutUs && motionRoot) {
  if (window.gsap) {
    gsap.context(initMotion, pageAboutUs);
  } else {
    initMotion();
  }
}
