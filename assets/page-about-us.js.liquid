"use strict";
const pageAboutUs = document.querySelector(".page-about-us");
const motionRoot = pageAboutUs ? pageAboutUs.querySelector(".page-about-us-content") : null;
const $ = (selector, scope = pageAboutUs) => scope ? scope.querySelector(selector) : null;
const $$ = (selector, scope = pageAboutUs) => scope && window.gsap ? gsap.utils.toArray(selector, scope) : [];

function setVisible(targets) {
  gsap.set(targets, { autoAlpha: 1, x: 0, y: 0, scale: 1, rotation: 0, clearProps: "transform,opacity,visibility" });
}

function reveal(targets, options = {}) {
  const elements = $$(targets);
  if (!elements.length) return;

  gsap.fromTo(
    elements,
    {
      autoAlpha: options.fromAlpha ?? 0,
      y: options.y ?? 48,
      x: options.x ?? 0,
      scale: options.scale ?? 1,
    },
    {
      autoAlpha: 1,
      y: 0,
      x: 0,
      scale: 1,
      duration: options.duration ?? 0.7,
      ease: options.ease ?? "power3.out",
      stagger: options.stagger ?? 0.08,
      scrollTrigger: {
        trigger: options.trigger || elements[0],
        start: options.start || "top 83%",
        toggleActions: "play none none none",
        once: true,
      },
    }
  );
}

function splitTextForReveal(element) {
  if (!element || element.dataset.typewriterReady === "true") {
    return $$(".typing-word", element);
  }

  const original = element.textContent.replace(/\s+/g, " ").trim();
  element.dataset.typewriterReady = "true";
  element.setAttribute("aria-label", original);
  element.textContent = "";

  const words = original.match(/\S+\s*/g) || [];
  const fragment = document.createDocumentFragment();

  words.forEach((word) => {
    const span = document.createElement("span");
    span.className = "typing-word";
    span.setAttribute("aria-hidden", "true");
    span.textContent = word;
    fragment.appendChild(span);
  });

  element.appendChild(fragment);
  return $$(".typing-word", element);
}

function typewriterReveal(selector, options = {}) {
  const element = $(selector);
  if (!element) return;

  const words = splitTextForReveal(element);
  if (!words.length) return;

  gsap.set(words, { autoAlpha: 0.08 });
  gsap.to(words, {
    autoAlpha: 1,
    ease: "none",
    stagger: options.stagger ?? 0.035,
    scrollTrigger: {
      trigger: options.trigger || element,
      start: options.start || "top 83%",
      end: options.end || "bottom 62%",
      scrub: 0.35,
    },
  });
}

function createHeroScroll() {
  const hero = $(".hero");
  const stage = $(".hero-fullscreen-stage");
  const stageImage = $(".hero-fullscreen-stage img");
  const finalFrame = $(".hero-image");
  const finalImage = $(".hero-image img");
  const copy = $(".hero-copy");
  const heading = $(".hero h1");
  const eyebrow = $(".hero .eyebrow");
  const intro = $(".hero-intro");

  if (!hero || !stage || !finalFrame || !finalImage || !copy) return;

  gsap.set(finalImage, { autoAlpha: 0 });
  gsap.set(copy, { autoAlpha: 0, y: 32 });
  gsap.set([eyebrow, heading, intro], { autoAlpha: 0, y: 24 });
  gsap.set(stage, {
    clipPath: "inset(0px 0px 0px 0px round 0px)",
    autoAlpha: 1,
  });

  const getTarget = () => {
    const rect = finalFrame.getBoundingClientRect();
    const heroRect = hero.getBoundingClientRect();
    const top = rect.top - heroRect.top;
    const left = rect.left - heroRect.left;

    return {
      top,
      right: stage.clientWidth - left - rect.width,
      bottom: stage.clientHeight - top - rect.height,
      left,
      width: rect.width,
      height: rect.height,
    };
  };

  const getImageTransform = (width, height, x = 0, y = 0) => {
    const imageWidth = stageImage.naturalWidth || stageImage.width || width;
    const imageHeight = stageImage.naturalHeight || stageImage.height || height;
    const scale = Math.max(width / imageWidth, height / imageHeight);

    return {
      x: x + (width - imageWidth * scale) / 2,
      y: y + height - imageHeight * scale,
      scale,
    };
  };

  const getStartImageTransform = () => getImageTransform(stage.clientWidth, stage.clientHeight);
  const getFinalImageTransform = () => {
    const target = getTarget();
    return getImageTransform(target.width, target.height, target.left, target.top);
  };

  const tl = gsap.timeline({
    defaults: { ease: "none" },
    scrollTrigger: {
      trigger: hero,
      start: "top top",
      end: "+=800",
      scrub: 0.4,
      pin: true,
      anticipatePin: 1,
      invalidateOnRefresh: true,
      onEnter: () => gsap.set(stage, { willChange: "clip-path, opacity" }),
      onEnterBack: () => gsap.set(stage, { willChange: "clip-path, opacity" }),
      onLeave: () => gsap.set(stage, { willChange: "auto" }),
      onLeaveBack: () => gsap.set(stage, { willChange: "auto" }),
    },
  });

  tl.to(stage, {
    clipPath: () => {
      const target = getTarget();
      return `inset(${target.top}px ${target.right}px ${target.bottom}px ${target.left}px round 20px)`;
    },
    duration: 0.82,
  }, 0)
    .fromTo(stageImage, {
      x: () => getStartImageTransform().x,
      y: () => getStartImageTransform().y,
      scale: () => getStartImageTransform().scale,
    }, {
      x: () => getFinalImageTransform().x,
      y: () => getFinalImageTransform().y,
      scale: () => getFinalImageTransform().scale,
      duration: 0.82,
    }, 0)
    .to(finalImage, { autoAlpha: 1, duration: 0.1 }, 0.82)
    .to(stage, { autoAlpha: 0, duration: 0.1 }, 0.82)
    .to(copy, { autoAlpha: 1, y: 0, duration: 0.12 }, 0.9)
    .to([eyebrow, heading, intro], { autoAlpha: 1, y: 0, stagger: 0.04, duration: 0.14 }, 0.94);
}

