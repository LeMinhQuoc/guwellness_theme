.page-about-us *,
.page-about-us *::before,
.page-about-us *::after {
  box-sizing: border-box;
}

.page-about-us {
  margin: 0;
  background: #ffffff;
}

.page-about-us img {
  display: block;
  max-width: 100%;
}

.page-about-us a {
  color: inherit;
  text-decoration: none;
}

.page-about-us button {
  border: 0;
  background: none;
  padding: 0;
  cursor: pointer;
}

.page-about-us .container {
  width: calc(100% - 80px);
  max-width: 1520px;
  margin-right: auto;
  margin-left: auto;
  padding-right: 0;
  padding-left: 0;
}

.page-about-us .section-pad-top {
  padding-top: 90px;
}

.page-about-us h1,
.page-about-us h2,
.page-about-us h3,
.page-about-us p {
  margin: 0;
}

.page-about-us h1 {
  color: #55723a;
  font-size: 56px;
  line-height: 64px;
  font-weight: 400;
  letter-spacing: -3px;
}

.page-about-us h3 {
  font-size: 28px;
  line-height: 36px;
  font-weight: 400;
  letter-spacing: -1.7px;
}

.page-about-us .eyebrow {
  font-size: 20px;
  line-height: 30px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: -0.2px;
}

.page-about-us .hero {
  position: relative;
  min-height: 100vh;
  padding-bottom: 0;
  overflow: hidden;
}

.page-about-us .hero-fullscreen-stage {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  pointer-events: none;
  transform-origin: top left;
  background: #f5f6ee;
}

.page-about-us .hero-fullscreen-stage img {
  position: absolute;
  top: 0;
  left: 0;
  width: auto;
  height: auto;
  max-width: none;
  transform-origin: top left;
}

.page-about-us .hero-copy {
  position: relative;
  z-index: 2;
  margin-top: 32px;
  padding-bottom: 80px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 80px;
}

.page-about-us .hero-intro {
  width: 577px;
  max-width: 45%;
  margin-top: 0;
  font-size: 20px;
  line-height: 30px;
}

.page-about-us .hero-image {
  position: relative;
  z-index: 1;
  margin-top: 32px;
  aspect-ratio: 16 / 9;
  border-radius: 20px;
  overflow: hidden;
}

.page-about-us .hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center bottom;
}

.page-about-us .origin {
  padding-top: 80px;
  padding-bottom: 80px;
}

.page-about-us .origin-copy {
  width: 50%;
  max-width: 760px;
}
.page-about-us .origin-intro {
  margin-top: 12px;
  font-size: 20px;
  line-height: 30px;
}
.page-about-us .origin-copy h2 {
  text-align: left;
}

.page-about-us .section-heading {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.page-about-us .section-heading.narrow {
  width: 615px;
}

.page-about-us .section-heading p,
.page-about-us .text-block p {
  font-size: 20px;
  line-height: 30px;
}

.page-about-us .question-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 32px;
}

.page-about-us .question-card {
  min-height: 164px;
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 32px 32px 32px 16px;
  border-radius: 20px;
  background: #fafafa;
}

.page-about-us .question-card img {
  width: 100px;
  height: 100px;
  object-fit: contain;
  flex: 0 0 auto;
}

.page-about-us .question-card p {
  font-size: 16px;
  line-height: 23px;
}

.page-about-us .ingredient-section {
  position: relative;
  padding: 0;
  background: #f5f6ee;
  overflow: visible;
}

.page-about-us .ingredient-shell {
  position: relative;
  z-index: 1;
  height: 780px;
  display: grid;
  grid-template-columns: minmax(0, calc(65% - 20px)) minmax(500px, 35%);
  align-items: center;
  gap: 20px;
  padding: 0 32px;
  border-radius: 20px;
  background: #f5f6ee;
}

.page-about-us .ingredient-content {
  padding-left: 0;
}

.page-about-us .ingredient-content h2 {
  max-width: 804px;
}

.page-about-us .ingredient-cards {
  margin-top: 32px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.page-about-us .ingredient-cards article {
  display: grid;
  grid-template-columns: 156px 1fr;
  align-items: center;
  min-height: 176px;
  gap: 4px;
  padding: 10px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12px 30px rgba(75, 96, 58, 0.08);
}

.page-about-us .ingredient-cards img {
  width: 156px;
  height: 156px;
  object-fit: contain;
  border-radius: 18px;
}

.page-about-us .ingredient-cards article > div {
  padding: 0 8px 0 12px;
}

.page-about-us .ingredient-cards p {
  margin-top: 4px;
  color: #30352f;
  font-size: 16px;
  line-height: 23px;
}

.page-about-us .map-card {
  position: relative;
  z-index: 1;
  border-radius: 20px;
  overflow: hidden;
  justify-self: end;
  width: 100%;
  max-width: 624px;
  max-width: 100%;
  aspect-ratio: 4 / 5;
}

.page-about-us .map-card img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.page-about-us .realization {
  padding-top: 80px;
  padding-bottom: 80px;
  text-align: center;
}

.page-about-us .quote-over-image {
  position: relative;
  height: 651px;
  overflow: hidden;
  border-radius: 20px;
}

.page-about-us .quote-over-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.page-about-us .quote-over-image p {
  position: absolute;
  top: 40px;
  left: 50%;
  width: 783px;
  transform: translateX(-50%);
  font-size: 20px;
  line-height: 30px;
}

.page-about-us .realization h2 {
  max-width: 994px;
  margin: 20px auto 0;
  color: #55723a;
}

.page-about-us .philosophy {
  position: relative;
  width: 100%;
  height: 900px;
  margin-inline: auto;
  scroll-margin-top: 90px;
  overflow: hidden;
  border-radius: 20px;
}

.page-about-us .philosophy-bg {
  position: absolute;
  top: -8%;
  left: 0%;
  width: 104%;
  height: 116%;
  object-fit: cover;
  object-position: center center;
}

.page-about-us .philosophy::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.82) 0%,
    rgba(255, 255, 255, 0.16) 45%,
    rgba(255, 255, 255, 0) 70%
  );
}

.page-about-us .philosophy-overlay {
  position: relative;
  z-index: 1;
  height: 100%;
  padding: 40px 32px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.page-about-us .philosophy-heading {
  max-width: 890px;
}

.page-about-us .glass-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  width: 100%;
  min-width: 0;
}

.page-about-us .glass-grid h3 {
  color: #fff;
}

.page-about-us .glass-grid article {
  min-height: 161px;
  min-width: 0;
  padding: 24px 20px;
  border-radius: 20px;
  background: rgba(66, 89, 47, 0.4);
  color: #fff;
  backdrop-filter: blur(8px);
}

.page-about-us .glass-grid p {
  margin-top: 8px;
  font-size: 16px;
  line-height: 23px;
}

.page-about-us .mission-vision {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  padding-top: 80px;
  padding-bottom: 40px;
  overflow: hidden;
}

.page-about-us .mission-vision article {
  overflow: hidden;
  border-radius: 20px;
}

.page-about-us .mission-vision img {
  width: 100%;
  height: 487px;
  object-fit: cover;
}

.page-about-us .text-block {
  position: relative;
  min-height: 162px;
  padding: 20px 20px 0;
}

.page-about-us .text-block h2 {
  margin-bottom: 12px;
}

.page-about-us .core-values {
  position: relative;
  min-height: 800px;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.page-about-us .core-bg {
  position: absolute;
  inset: 0;
}

.page-about-us .core-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.page-about-us .core-layout {
  position: relative;
  z-index: 1;
  min-height: 640px;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20px;
  align-items: center;
}
.page-about-us .core-layout h3 {
  color: var(--shop-color-text);
}
.page-about-us .core-layout > h2 {
  color: #89351a;
  text-align: center;
}

.page-about-us .value-list {
  display: grid;
  gap: 24px;
}

.page-about-us .value-list article {
  min-height: 212px;
  padding: 24px;
  border-radius: 20px;
  background: #fef8ed;
  box-shadow: 0 12px 8px rgba(239, 217, 170, 0.35);
}

.page-about-us .value-list img {
  width: 100px;
  height: 100px;
  margin-top: 20px;
}

.page-about-us .team {
  padding-top: 80px;
  padding-bottom: 40px;
  text-align: center;
}

.page-about-us .team-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 32px;
  text-align: left;
}

.page-about-us .team-grid article {
  padding: 16px;
  border-radius: 20px;
  background: transparent;
}

.page-about-us .team-grid img {
  width: 100%;
  height: 311px;
  object-fit: cover;
  border-radius: 12px;
}

.page-about-us .team-grid h3 {
  margin-top: 16px;
}

.page-about-us .team-grid ul {
  margin-top: 8px;
  padding-left: 20px;
  list-style: disc;
}

.page-about-us .team-grid li {
  font-size: 16px;
  line-height: 23px;
}

.page-about-us .timeline {
  padding: 40px 0 80px;
  text-align: center;
}

.page-about-us .timeline-list {
  position: relative;
  width: 440px;
  max-width: 100%;
  min-height: 300px;
  margin: 20px auto 0;
  text-align: left;
}

.page-about-us .timeline-line {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1px;
  background: linear-gradient(to bottom, rgba(169, 219, 226, 0), #a9dbe2 18%, #a9dbe2 82%, rgba(169, 219, 226, 0));
  transform: scaleY(1);
  transform-origin: top center;
}

.page-about-us .timeline-list article {
  position: relative;
  width: 50%;
  min-height: 96px;
}

.page-about-us .timeline-list article::after {
  content: "";
  position: absolute;
  top: 20px;
  width: 0;
  height: 0;
  border-top: 6px solid transparent;
  border-bottom: 6px solid transparent;
}

.page-about-us .timeline-left {
  padding-right: 24px;
  text-align: right;
}

.page-about-us .timeline-right {
  margin-left: 50%;
  padding-left: 24px;
}

.page-about-us .timeline-left::after {
  right: -1px;
  border-right: 10px solid #a9dbe2;
}

.page-about-us .timeline-right::after {
  left: -1px;
  border-left: 10px solid #a9dbe2;
}

.page-about-us .timeline-list article + article {
  margin-top: -4px;
}

.page-about-us .timeline-list article > span {
  display: block;
  color: #0a0a0a;
  font-size: 48px;
  line-height: 58px;
  font-weight: 400;
  letter-spacing: -2.5px;
}

.page-about-us .timeline-list h3 {
  font-size: 32px;
  line-height: 38px;
  letter-spacing: -1.2px;
}

.page-about-us .timeline-list ul {
  margin: 8px 0 0;
  padding-left: 16px;
  font-size: 14px;
  line-height: 20px;
  letter-spacing: -0.2px;
  list-style: disc;
}

.page-about-us .timeline-left ul {
  direction: rtl;
  padding-left: 0;
  padding-right: 16px;
}

.page-about-us .timeline-left li {
  direction: ltr;
}

.page-about-us .sustainability {
  padding-bottom: 80px;
}

.page-about-us .sustainability h2 {
  text-align: center;
}

.page-about-us .sustain-list {
  width: 746px;
  max-width: 100%;
  margin: 32px auto 0;
  display: grid;
  gap: 20px;
}

.page-about-us .sustain-list article {
  display: grid;
  grid-template-columns: 337px 1fr;
  gap: 20px;
  align-items: center;
}

.page-about-us .sustain-list img {
  width: 337px;
  height: 225px;
  object-fit: cover;
  border-radius: 12px;
}

.page-about-us .sustain-list ul {
  margin-top: 8px;
  padding-left: 20px;
  list-style: disc;
}

.page-about-us .sustain-list li {
  font-size: 16px;
  line-height: 23px;
}

.page-about-us .community {
  padding-bottom: 80px;
}

.page-about-us .community-heading {
  text-align: center;
  margin-bottom: 32px;
}

.page-about-us .community-heading h2 {
  width: 1108px;
  max-width: 100%;
  margin: 12px auto 0;
  color: #55723A;
}

.page-about-us .community-image {
  position: relative;
  height: 855px;
  scroll-margin-top: 90px;
  overflow: hidden;
  border-radius: 20px;
}

.page-about-us .community-image > img {
  width: 100%;
  height: 116%;
  object-fit: cover;
  object-position: center center;
}

.page-about-us .community-cards {
  position: absolute;
  left: 32px;
  right: 32px;
  bottom: 32px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}
.page-about-us .community-cards h3 {
  color: #fff; 
}
.page-about-us .community-cards article {
  min-height: 188px;
  padding: 16px;
  border-radius: 12px;
  background: rgba(66, 89, 47, 0.42);
  color: #fff;
  backdrop-filter: blur(10px);
}

.page-about-us .community-cards ul {
  margin-top: 12px;
  padding-left: 20px;
  list-style: disc;
}

.page-about-us .community-cards li {
  font-size: 16px;
  line-height: 23px;
}

.page-about-us .collab {
  position: relative;
  height: 1015px;
  scroll-margin-top: 90px;
  overflow: hidden;
  border-radius: 20px;
  background: linear-gradient(#eefbff, #dff5fb);
  text-align: center;
}

.page-about-us .collab-copy {
  position: relative;
  z-index: 2;
  padding-top: 72px;
}

.page-about-us .collab-copy h2 {
  width: 665px;
  max-width: calc(100% - 40px);
  margin: 12px auto 0;
}

.page-about-us .letter-stack {
  position: absolute;
  left: calc(50% + 11.5px);
  top: 242px;
  width: 877px;
  height: 1012px;
  transform: translateX(-50%);
}

.page-about-us .letter {
  position: absolute;
  object-fit: contain;
}

.page-about-us .letter.back {
  width: 835px;
  height: 880px;
  left: 42px;
  top: 132px;
}

.page-about-us .letter.l1 {
  width: 556px;
  height: 543px;
  left: 0;
  top: 0;
}

.page-about-us .letter.l2 {
  width: 515px;
  height: 503px;
  left: 356px;
  top: 82px;
}

.page-about-us .letter.l3 {
  width: 492px;
  height: 499px;
  left: 122px;
  top: 249px;
}

.page-about-us .letter.l4 {
  width: 500px;
  height: 444px;
  left: 234px;
  top: 449px;
}

.page-about-us .letter.front {
  width: 829px;
  height: 574px;
  left: 45px;
  top: 434px;
}

.page-about-us .gu-button {
  position: relative;
  z-index: 3;
  display: inline-flex;
  align-items: center;
  margin-top: 690px;
  gap: 0;
  color: #fff;
  font-size: 18px;
  line-height: 18px;
  text-transform: uppercase;
  letter-spacing: -0.2px;
}

.page-about-us .button-icon {
  position: relative;
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
  border-radius: 100px;
  background: #55723a;
}

.page-about-us .button-icon img {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20px;
  height: 20px;
  transform: translate(-50%, -50%);
}

.page-about-us .button-label {
  min-height: 40px;
  display: inline-flex;
  align-items: center;
  margin-left: -1px;
  padding: 0 20px;
  border-radius: 100px;
  background: #55723a;
}

.page-about-us .contact {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  padding: 40px 0;
}

.page-about-us .contact article {
  min-height: 325px;
  padding: 32px;
  border-radius: 12px;
  background: #f4f5ef;
}

.page-about-us .contact h3 {
  margin-top: 20px;
}

.page-about-us .contact p {
  margin: 8px 0 28px;
  font-size: 16px;
  line-height: 23px;
}

.page-about-us .contact .gu-button {
  margin-top: 0;
}

@media (prefers-reduced-motion: reduce) {
  .page-about-us {
    scroll-behavior: auto;
  }

  .page-about-us *,
.page-about-us *::before,
.page-about-us *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

@media (max-width: 1180px) {
  .page-about-us .container,
  .page-about-us .philosophy {
    width: calc(100% - 48px);
  }

  .page-about-us .hero-copy,
.page-about-us .ingredient-shell,
.page-about-us .mission-vision,
.page-about-us .contact {
    grid-template-columns: 1fr;
    display: grid;
  }

  .page-about-us .hero-intro {
    max-width: none;
    width: auto;
    margin-top: 0;
  }

  .page-about-us .hero-copy {
    height: auto;
    align-items: flex-start;
    gap: 24px;
  }

  .page-about-us .ingredient-content {
    padding-left: 0;
  }

  .page-about-us .ingredient-shell {
    height: auto;
    padding: 40px 24px;
  }

  .page-about-us .map-card {
    justify-self: center;
  }

  .page-about-us .map-card img {
    height: 100%;
  }

  .page-about-us .glass-grid,
.page-about-us .community-cards {
    grid-template-columns: repeat(2, 1fr);
  }

  .page-about-us .core-layout {
    grid-template-columns: 1fr;
  }

}

@media (max-width: 720px) {
  .page-about-us .container,
  .page-about-us .philosophy {
    width: calc(100% - 32px);
  }

  .page-about-us h1 {
    font-size: 40px;
    line-height: 46px;
    letter-spacing: -1.6px;
  }

  .page-about-us h2 {

  }

  .page-about-us .quote-over-image {
    height: 360px;
  }

  .page-about-us .section-heading.narrow,
.page-about-us .origin-copy,
.page-about-us .quote-over-image p {
    width: auto;
  }

  .page-about-us .quote-over-image p {
    left: 24px;
    right: 24px;
    transform: none;
  }

  .page-about-us .question-grid,
.page-about-us .ingredient-cards,
.page-about-us .team-grid,
.page-about-us .sustain-list article,
.page-about-us .glass-grid,
.page-about-us .community-cards {
    grid-template-columns: 1fr;
  }

  .page-about-us .ingredient-cards article {
    grid-template-columns: 120px 1fr;
  }

  .page-about-us .ingredient-cards img {
    width: 120px;
    height: 120px;
  }

  .page-about-us .philosophy {
    height: auto;
    min-height: 900px;
  }

  .page-about-us .mission-vision img {
    height: auto;
  }

  .page-about-us .timeline-list article > span {
    font-size: 34px;
    line-height: 40px;
    letter-spacing: -1.4px;
  }

  .page-about-us .community-image {
    height: auto;
  }

  .page-about-us .community-image > img {
    height: auto;
  }

  .page-about-us .community-cards {
    position: static;
    margin-top: 12px;
  }

  .page-about-us .collab {
    height: 760px;
  }

  .page-about-us .letter-stack {
    width: 720px;
    transform: translateX(-50%) scale(0.62);
    transform-origin: top center;
  }

  .page-about-us .collab .gu-button {
    margin-top: 510px;
  }

  .page-about-us .hero,
  .page-about-us .hero-copy {
    min-height: auto;
    padding-top: 0;
    padding-bottom: 0;
  }

  .page-about-us .origin,
  .page-about-us .realization,
  .page-about-us .mission-vision,
  .page-about-us .team {
    padding-top: 30px;
    padding-bottom: 30px;
  }
