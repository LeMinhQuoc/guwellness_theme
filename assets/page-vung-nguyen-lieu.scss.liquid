}*/

.page-vung-nguyen-lieu .map-pin-tooltip {
  position: absolute;
  left: 50%;
  border: 1px solid #CCDAB9;
  bottom: calc(100% + 10px);
  z-index: 3;
  min-width: 0;
  width: max-content;
  padding: 16px 20px;
  border-radius: 14px;
  background: #fff;
  color: #0A0A0A;
  font-size: 22px;
  white-space: nowrap;
  opacity: 0;
  visibility: hidden;
  transform: translateX(-50%) translateY(4px);
  transition: opacity 160ms ease, transform 160ms ease, visibility 160ms ease;
  box-shadow: 0 12px 16px -4px rgba(16, 24, 40, 0.08), 0 4px 6px -2px rgba(16, 24, 40, 0.03);
  pointer-events: none;
}

.page-vung-nguyen-lieu .map-pin-tooltip::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 100%;
  width: 0;
  height: 0;
  border: 6px solid transparent;
  border-top-color: #fff;
  transform: translateX(-50%);
}

.page-vung-nguyen-lieu .map-pin:hover .map-pin-tooltip,
.page-vung-nguyen-lieu .map-pin.is-active .map-pin-tooltip {
