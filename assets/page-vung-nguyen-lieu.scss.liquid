  color: #fff;
}

.page-vung-nguyen-lieu .farmtour {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  align-items: center;
  min-height: 750px;
  margin-top: 80px;
  margin-bottom: 80px;
  padding: 0;
  overflow: hidden;
  border: 1px solid #e5ebdb;
  border-radius: 20px;
  background: #f5f6ee;
}

.page-vung-nguyen-lieu .farmtour > img {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  align-self: center;
  object-fit: cover;
  border-radius: 20px;
}

.page-vung-nguyen-lieu .farmtour-copy {
  display: grid;
  gap: 40px;
  padding: 0 40px 0 20px;
}

.page-vung-nguyen-lieu .farmtour-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin: 0;
}

.page-vung-nguyen-lieu .farmtour-cards article {
  min-height: 271px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 28px 24px;
  border: 1px solid #e5ebdb;
  border-radius: 20px;
  background: #fff;
}

.page-vung-nguyen-lieu .farmtour-cards article:nth-child(2) {
  background: #e5ebdb;
}

.page-vung-nguyen-lieu .farmtour .gu-button {
  margin-top: 0;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
}

.page-vung-nguyen-lieu .ingredients-cta {
  position: relative;
  margin-top: 80px;
  margin-bottom: 15px;
  overflow: hidden;
  width: 100%;
}

.page-vung-nguyen-lieu .ingredients-cta > img {
  display: block;
}

.page-vung-nguyen-lieu .ingredients-cta > div {
  position: absolute;
  left: 48px;
  bottom: 48px;
  z-index: 2;
  width: calc(100% - 96px);
  max-width: 620px;
}

.page-vung-nguyen-lieu .ingredients-cta .gu-button {
  margin-top: 24px;
}

.page-vung-nguyen-lieu.motion-ready .ingredients-hero-media,
.page-vung-nguyen-lieu.motion-ready .ingredients-hero-media img,
.page-vung-nguyen-lieu.motion-ready .process-heading,
.page-vung-nguyen-lieu.motion-ready .process-list article,
.page-vung-nguyen-lieu.motion-ready .process-arrow,
.page-vung-nguyen-lieu.motion-ready .standards-list article,
.page-vung-nguyen-lieu.motion-ready .sustainability-image,
.page-vung-nguyen-lieu.motion-ready .sustainability-pillars article,
.page-vung-nguyen-lieu.motion-ready .future-section > img,
.page-vung-nguyen-lieu.motion-ready .future-copy > *,
.page-vung-nguyen-lieu.motion-ready .future-cards article,
.page-vung-nguyen-lieu.motion-ready .farmtour > img,
.page-vung-nguyen-lieu.motion-ready .farmtour-copy > *,
.page-vung-nguyen-lieu.motion-ready .ingredients-cta > img,
.page-vung-nguyen-lieu.motion-ready .ingredients-cta > div > * {
  will-change: transform, opacity;
}

@media (max-width: 1180px) {
  .page-vung-nguyen-lieu .ingredients-hero {
    padding-bottom: 32px;
  }

  .page-vung-nguyen-lieu .container {
    width: calc(100vw - 48px);
    max-width: 1520px;
  }

  .page-vung-nguyen-lieu .ingredients-hero-media {
    height: 62vw;
    min-height: 420px;
  }

  .page-vung-nguyen-lieu .ingredients-hero-copy,
  .page-vung-nguyen-lieu .source-map-grid,
  .page-vung-nguyen-lieu .process-grid,
  .page-vung-nguyen-lieu .standards-section,
  .page-vung-nguyen-lieu .farmtour {
    grid-template-columns: 1fr;
  }

  .page-vung-nguyen-lieu .map-panel,
  .page-vung-nguyen-lieu .ingredient-tabs,
  .page-vung-nguyen-lieu .production-process .process-heading,
  .page-vung-nguyen-lieu .standards-section .process-heading {
    position: static;
  }

  .page-vung-nguyen-lieu .map-panel {
    max-width: 680px;
    margin-inline: auto;
  }

  .page-vung-nguyen-lieu .sustainability-pillars,
  .page-vung-nguyen-lieu .future-cards,
  .page-vung-nguyen-lieu .certificate-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .page-vung-nguyen-lieu .farmtour {
    padding: 20px;
  }

  .page-vung-nguyen-lieu .farmtour-copy {
    padding: 0;
  }

  .page-vung-nguyen-lieu .ingredients-cta {
    height: 560px;
  }
}

@media (max-width: 720px) {
  .page-vung-nguyen-lieu .ingredients-hero {
    padding-bottom: 24px;
  }

  .page-vung-nguyen-lieu .container {
    width: calc(100vw - 32px);
    max-width: none;
  }

  .page-vung-nguyen-lieu .ingredients-hero-copy h1,
  .page-vung-nguyen-lieu .ingredients-hero-copy > p {
    width: 100%;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .page-vung-nguyen-lieu .ingredients-hero-media,
  .page-vung-nguyen-lieu .ingredients-hero-copy {
    width: calc(100vw - 32px);
    max-width: calc(100vw - 32px);
  }

  .page-vung-nguyen-lieu .ingredients-hero-copy {
    width: calc(100vw - 64px);
    max-width: 280px;
  }

  .page-vung-nguyen-lieu .ingredients-hero-copy h1 {
    font-size: 34px;
    line-height: 40px;
    letter-spacing: -1.4px;
  }

  .page-vung-nguyen-lieu .ingredients-hero-copy > p {
    font-size: 18px;
    line-height: 28px;
  }

  .page-vung-nguyen-lieu .source-map {
    padding: 40px 16px;
  }

  .page-vung-nguyen-lieu .ingredients-hero-media,
  .page-vung-nguyen-lieu .sustainability-image,
  .page-vung-nguyen-lieu .future-section,
  .page-vung-nguyen-lieu .ingredients-cta {
    height: auto;
    min-height: 0;
    aspect-ratio: 4 / 5;
  }

  .page-vung-nguyen-lieu .ingredients-hero-copy,
  .page-vung-nguyen-lieu .metric-row,
  .page-vung-nguyen-lieu .cultivation-grid,
  .page-vung-nguyen-lieu .nutrition-grid,
  .page-vung-nguyen-lieu .sustainability-pillars,
  .page-vung-nguyen-lieu .future-cards,
  .page-vung-nguyen-lieu .farmtour-cards,
  .page-vung-nguyen-lieu .process-list,
  .page-vung-nguyen-lieu .standards-list,
  .page-vung-nguyen-lieu .certificate-grid {
    grid-template-columns: 1fr;
  }

  .page-vung-nguyen-lieu .ingredient-quote,
  .page-vung-nguyen-lieu .partner-quote {
    border-radius: 16px;
    font-size: 20px;
    line-height: 28px;
    padding: 22px 24px;
  }

  .page-vung-nguyen-lieu .ingredient-quote {
    margin: 0 16px;
  }

  .page-vung-nguyen-lieu .ingredient-photo {
    margin-bottom: -48px;
    min-height: 0;
  }

  .page-vung-nguyen-lieu .ingredient-photo img {
    height: 260px;
  }

  .page-vung-nguyen-lieu .future-copy,
  .page-vung-nguyen-lieu .future-cards,
  .page-vung-nguyen-lieu .ingredients-cta > div {
    position: relative;
    inset: auto;
    width: auto;
    transform: none;
  }

  .page-vung-nguyen-lieu .future-section,
  .page-vung-nguyen-lieu .ingredients-cta {
    display: grid;
    gap: 20px;
  }

  .page-vung-nguyen-lieu .future-section > img {
    position: relative;
    inset: auto;
  }

  .page-vung-nguyen-lieu .sustainability-pillars article,
  .page-vung-nguyen-lieu .farmtour-cards article {
    min-height: auto;
    gap: 40px;
  }

  .page-vung-nguyen-lieu .farmtour {
    min-height: 0;
    margin-top: 48px;
    margin-bottom: 48px;
  }

  .page-vung-nguyen-lieu .future-copy,
  .page-vung-nguyen-lieu .ingredients-cta > div {
    padding: 0 20px 24px;
    text-align: left;
  }

  .page-vung-nguyen-lieu .future-cards {
    padding: 0 20px 20px;
  }

  .page-vung-nguyen-lieu .ingredients-cta {
    margin-top: 48px;
    aspect-ratio: 4 / 5;
  }

  .page-vung-nguyen-lieu .ingredients-cta > img {
    position: relative;
    inset: auto;
  }

  .page-vung-nguyen-lieu .ingredients-cta > div {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 24px;
    width: auto;
    max-width: none;
    padding: 0;
  }
}
