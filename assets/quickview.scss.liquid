	.modal-detailProduct .product-variants .select-actions .quantity-area input.quantity-input {width: 50px;height: 38px;line-height: 36px;}
	.modal-detailProduct .product-variants .select-actions .quantity-area input.qty-btn {width: 38px;height: 38px;line-height: 36px;}
