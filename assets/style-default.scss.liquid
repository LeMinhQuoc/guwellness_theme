{%- for i in (1..30) -%}
{%- capture show_color -%}use_color_filter_{{i}}{%- endcapture -%}
{%- capture name_color -%}color_name_new_{{i}}{%- endcapture -%}
{%- capture code_color -%}color_code_new_{{i}}{%- endcapture -%}
{%- assign set_name_color = settings[name_color] | downcase | handleize -%}
{%- if settings[show_color] -%}
.swatch .swatch-element.color label.{{ set_name_color }} {
	font-size:0;background: {{ settings[code_color] }};border-radius:50%;
	padding: 0;
	min-width: 26px;
	width: 26px;height: 26px;line-height: 26px;
	background-image: none;
	&.sd {box-shadow: 0 0 0 3px #ffffff, 0 0 0 4px #d4d4d4;}
	&.sd:before {content:none;}
	&.sd:after {content:none;}
}
.variantColor .vrt-color span.{{ set_name_color }} {background: {{ settings[code_color] }};}
{%- endif -%}
{%- endfor -%}

