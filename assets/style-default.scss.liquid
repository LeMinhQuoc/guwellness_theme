  .d-flex-slide:not(.owl-loaded) {
  display: flex;
  flex-wrap: nowrap;
  overflow: hidden;
  gap: 15px;
  .item-fv {
    flex: 0 0 calc(100% / 5 - 15px);
    max-width: calc(100% / 5 - 15px);
    @media (max-width: 991px) { flex: 0 0 calc(100% / 3 - 15px);max-width: calc(100% / 3 - 15px); }
    @media (max-width: 767px) { flex: 0 0 calc(100% / 2 - 15px); max-width: calc(100% / 2 - 15px); }
  }
  .item-fov {
    flex: 0 0 calc(100% / 4 - 15px); max-width: calc(100% / 4 - 15px);
    @media (max-width: 991px) { flex: 0 0 calc(100% / 2 - 15px);max-width: calc(100% / 2 - 15px); }
    @media (max-width: 767px) { flex: 0 0 100%; max-width: 100%; }
  }
  .item-thr {
    flex: 0 0 calc(100% / 3 - 15px);
    max-width: calc(100% / 3 - 15px);
    @media (max-width: 991px) { flex: 0 0 calc(100% / 3 - 15px);max-width: calc(100% / 3 - 15px); }
    @media (max-width: 767px) { flex: 0 0 calc(100% / 2 - 15px); max-width: calc(100% / 2 - 15px); }
  }
  .item-one {
    flex: 0 0 100%;
    max-width: 100%;
  }
