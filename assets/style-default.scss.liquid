@keyframes rotating {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}
.block-heading {
  --subtitle: #8C8C8C;
  display: flex;flex-direction: column;
  gap: 20px;
  @media (max-width: 992px) {gap: 15px;align-items: center;}
  .block-heading--subtitle {
    display: flex;
    align-items: center;
    justify-content: left;
    gap: 12px;
    @media (min-width: 992px) {
      flex-direction: row-reverse;
    }
  }
  .subtitle-icon {
    .subtitle-icon__animate {display: block;animation: rotating 3s linear infinite;}
    img {width: 16px;height: 17px;}
  }
  .subtitle-text {
    color: var(--subtitle);
    font-weight: 500;
  }
  .block-heading--title {
    h2 {
      font-size: 45px;        
      line-height: 120%;
      letter-spacing: -0.03em;
      font-weight: 500;
      @media (max-width: 992px) {font-size: 30px;text-align: center;}
    }
  }
}
body.modal-open.fix-modal-scroll {
  overflow-y: scroll; 
  margin-right: -15px;
}


.theme-translate-wrapper {
  position: relative;  
  cursor: pointer;
  .language-text{font-size: 14px;font-weight: 400;}
  .theme-translate-dropdown-wrapper {
     position: absolute;
    left: 0;z-index: 9;
    padding-top: 12px;
    margin-top: -12px;
    width: 100%;
    transition: .3s all;
    opacity: 0;visibility: hidden;
    pointer-events: none;
    .theme-translate-dropdown {
      overflow-y: auto;
      font-size: 12px;
      scroll-padding: .5rem 0;
      width: 100%;
      min-width: 105px;
      background-color: white;
      text-align: left;
      z-index: 99;
      left: 0;
      box-shadow: 0px 7px 18px rgba(0,0,0,0.2);
      .js-language-select{
        .flag{
          svg{width: 14px;height: 14px;}
        }
      }
      a {
        display: block;
        padding: 5px 8px;
        transition: .3s all;
        color: var(--traslate-color);
        background-color: transparent;
        &:hover {
          background-color: var(--traslate-color);
          color: var(--traslate-colorhover);
        }
      }
      
    }
  }
  .icon-svg {
    --icon-height: 12px;
    --icon-width: 12px;
  }
  &:hover,
  &.active {
    .theme-translate-dropdown-wrapper {
      opacity: 1;visibility: visible;
      pointer-events: auto;
    }
    .icon-svg {
      transform: rotate(-180deg);
    }
  }
}
@media(max-width: 991px){
  .theme-header-action_translate{
    display: none;
  }
}
.footer .theme-translate-wrapper .theme-translate-dropdown-wrapper {
  bottom: 100%;
  padding-bottom: 15px;
  margin-bottom: 0px;
}

.hrv-sidebar-main {
	.hrv-sitenav-wrapper {
		position: fixed;
		top: 0;
		bottom: 0;
		z-index: 1010;
		background: transparent;
		&.hrv-sitenav-right {
			right: 0;
			.hrv-sitenav-inner {
				right: 0;
				-webkit-transform: translateX(120%);
				transform: translateX(120%);
				-webkit-transition: transform 0.35s ease
					, right 0.25s ease
					, visibility 0s;
				transition: transform 0.35s ease
					, right 0.25s ease
					, visibility 0s;
			}
		}
		&.hrv-sitenav-left {
			left: 0;
			.hrv-sitenav-inner {
				left: 0;
				-webkit-transform: translateX(-100%);
				transform: translateX(-100%);
				-webkit-transition: transform 0.35s ease
					, left 0.25s ease
					, visibility 0s;
				transition: transform 0.35s ease
					, left 0.25s ease
					, visibility 0s;
			}
		}
		.hrv-sitenav-inner {
			margin: 0 auto;
			max-width: 480px;
			position: absolute;
			top: 0;
			bottom: 0;
			background: #ffffff;
			background-clip: padding-box;
			display: flex;
			flex-direction: column;
			&:after {
				content: "";
				position: absolute;
				width: 100%;
				height: 100%;
				background: #fff;
				z-index: 1;
				opacity: 1;
				visibility: visible;
			}
		}
	}
	&.hrv-is-show-right {
		.hrv-sitenav-wrapper.hrv-show {
			left: 0 !important;
			-webkit-transition-delay: 0s;
			transition-delay: 0s;
		}
		.hrv-sitenav-wrapper.hrv-show .hrv-sitenav-inner {
			right: 0;
			width: 85%;
			-webkit-transform: translateX(0);
			transform: translateX(0);
			-webkit-transition-delay: 0.1s;
			transition-delay: 0.1s;
			-webkit-transition-duration: 0.3s;
			transition-duration: 0.3s;
			&:after {
				visibility: hidden;
				opacity: 0;
			}
		}
		.hrv-sitenav-wrapper.hrv-show .hrv-sidebar-overlay {
			opacity: 1;
			visibility: visible;
		}
	}
	&.hrv-is-show-left {
		.hrv-sitenav-wrapper.hrv-show {
			right: 0 !important;
			-webkit-transition-delay: 0s;
			transition-delay: 0s;
		}
		.hrv-sitenav-wrapper.hrv-show .hrv-sitenav-inner {
			left: 0;
			width: 85%;
			-webkit-transform: translateX(0);
			transform: translateX(0);
			-webkit-transition-delay: 0.1s;
			transition-delay: 0.1s;
			-webkit-transition-duration: 0.3s;
			transition-duration: 0.3s;
			&:after {
				visibility: hidden;
				opacity: 1;
			}
		}
		.hrv-sitenav-wrapper.hrv-show .hrv-sidebar-overlay {
			opacity: 1;
			visibility: visible;
		}
	}
	.hrv-sidebar-overlay {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 100%;
		z-index: -1;
		background-color: rgba(0, 0, 0, 0.5);
		opacity: 0;
		visibility: hidden;
		transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
	}
	.hrv-sitenav-header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		padding: 15px;
		border-bottom: 1px solid var(--shop-color-border);
	}
	.hrv-sitenav-content {
		padding: 15px;
		position: relative;
		overflow-y: scroll;
		height: 100%;
		-webkit-overflow-scrolling: touch;
		-ms-scroll-chaining: none;
		overscroll-behavior: none;
		.hrv-svgico-mini-cart {
			padding-top: 20px;
			padding-bottom: 20px;
			position: relative;
			text-align: center;
		}
		.hrv-cart-empty .hrv-action-link-empty {
			display: flex;
			justify-content: space-around;
			margin-top: 10px;
			@media (max-width: 991px) {
				flex-direction: column;
			}
			a {
				border: 0;
				font-size: 14px;
				text-decoration: underline;
				color: #1a73e8;
				cursor: pointer;
			}
		}
	}
	.hrv-cart-empty hrv-sitenav-footer {display: none;}
	.hrv-sitenav-footer {
		padding: 15px;
		margin-top: auto;
		border-top: 1px solid var(--mnc-border);
	}
}

