/* [WARN] Dependencies: jQuery, Swiper — load trước file này. */
window.StreetVibe = window.StreetVibe || {};
StreetVibe.IndexReviewSlider = StreetVibe.IndexReviewSlider || {
  init: function () {
    var that = this;
    that.StreetVibe_IndexReviewSlider();
  },
  StreetVibe_IndexReviewSlider: function () {
    const streetvibeSlider = new Swiper(".streetvibe-index-review .swiper", {
      slidesPerView: 1,
      loop: $(".streetvibe-index-review .review-item").length > 1 ? true : false,
      speed: 1000,
      autoplay: false,
      effect: "fade",
      fadeEffect: {
        crossFade: true,
      },
      navigation: {
        nextEl: ".streetvibe-index-review .swiper-next",
        prevEl: ".streetvibe-index-review .swiper-prev",
      },
    });
    const totalSlides = streetvibeSlider.slides.length;
    if (totalSlides <= streetvibeSlider.params.slidesPerView) {
      $(".streetvibe-index-review .swiper-next, .streetvibe-index-review .swiper-prev").hide();
    }
  },
};
document.addEventListener("DOMContentLoaded", function () {
  if (typeof StreetVibe !== "undefined" && StreetVibe.IndexReviewSlider) {
    StreetVibe.IndexReviewSlider.init();
  }
});
