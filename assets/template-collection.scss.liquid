.collection-content{
	margin-top: 40px;
  .filter-icon{
    cursor: pointer;
    display: inline-block;
    position: relative;
    top: 40px;
    z-index: 3;
    .icon-filter{
      svg{
        circle{
          transition: all 0.3s;
        fill: var(--shop-color-bg);
        }
      }
    }
    .icon-right svg{
      transition: all 0.3s;
    }
    &.show{
      .icon-filter{
        svg circle{
          &:nth-child(3){
            transform: translate(6px);
          }
          &:nth-child(4){
            transform: translate(-6px);
          }
        }
      }
      .icon-right svg{
        transform: rotate(180deg);
      }
    }
  }
  @media(min-width: 992px){
    .aside-groupNav{
      position: sticky;
      top: 90px;
      padding: 60px 30px 0 0;
    }
    .col-content > div{
      padding: 0;
    }
    .col-filter{
      /*-ms-flex: 0 0 0;
      flex: 0 0 0;
      max-width: 0;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s;*/
      display: none;
      &.show{
        /*-ms-flex: 0 0 25%;
        flex: 0 0 25%;
        max-width: 25%;
        opacity: 1;
        visibility: visible;*/
        display: block;
      }
    }
    .col-pro.width-full{
      -ms-flex: 0 0 100%;
      flex: 0 0 100%;
      max-width: 100%;
      .layered_filter_tags{
    display: none;
      }
    }
  }
  @media(max-width: 991px){
    .aside-groupNav,.filter-icon{display: none;}
  }
}
