.collection-listproduct .button {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: inline-block;
    padding: 18px 45px;
    line-height: normal;
    border: 0;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    letter-spacing: 1px;
    outline: none !important;
    -webkit-transition: all 0.45s;
    transition: all 0.45s;
    @media(min-width: 992px) {
       &:hover,
      &.has-hover,
       &:focus {
        border-color: transparent;
         opacity: 0.8;
      }
    }
    @media(max-width: 767px) {
      font-size: 12px;
      padding: 8px 15px;
      min-height: 35px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

