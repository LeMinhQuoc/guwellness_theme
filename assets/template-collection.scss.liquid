	gap: 12px;
}

.layout-collections .collection-active-filter-tag {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	padding: 8px 8px 8px 12px;
	margin-bottom: 15px;
	font-size: 13px;
	font-weight: 600;
	line-height: 13px;
	letter-spacing: -0.2px;
	color: var(--collection-green);
	border: 0;
	border-radius: 50px;
	background: var(--collection-surface);
}

.layout-collections .collection-active-filter-tag svg {
	width: 10px;
	height: 10px;
}

.layout-collections .collection-clear-filters {
	padding: 4px 0;
	font-family: var(--heading-font-family), Georgia, serif;
	font-size: 18px;
	font-weight: 500;
	line-height: 18px;
	letter-spacing: -0.5px;
	color: var(--collection-green);
	text-decoration: underline;
	text-transform: uppercase;
	border: 0;
	background: transparent;
	margin-bottom: 15px;
}

.layout-collections .container-pd-parent,
.layout-collections .collection-wraper,
.layout-collections .wraplist-collection {
	width: 100%;
}

.layout-collections .listProduct-row {
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr));
	gap: 20px;
	margin: 0;
}

.layout-collections .listProduct-row > .product-card {
	width: 100%;
	max-width: none;
	min-width: 0;
	height: 485px;
	padding: 0;
	margin: 0;
}

.layout-collections .product-card-link {
	display: flex;
	flex-direction: column;
	height: 100%;
	color: var(--collection-text);
}

.layout-collections .product-card-link:hover {
	color: var(--collection-text);
	text-decoration: none;
}

.layout-collections .product-card__image {
	flex: 0 0 auto;
	width: 100%;
	aspect-ratio: 284 / 320;
	overflow: hidden;
	border-radius: 12px;
	background: #f8f3ee;
}

.layout-collections .product-card__image img {
	display: block;
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.5s ease;
}

.layout-collections .product-card-link:hover .product-card__image img {
	transform: scale(1.025);
}

.layout-collections .product-card__body {
	display: flex;
	flex-direction: column;
	gap: 2px;
	padding: 16px 0;
}

.layout-collections .product-card__title {
	display: -webkit-box;
	min-height: 46px;
	margin: 0;
	overflow: hidden;
	font-family: var(--base-font-family), Arial, sans-serif;
	font-size: 16px;
	font-weight: 400;
	line-height: 23px;
	letter-spacing: -0.2px;
	color: var(--collection-text);
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
}

.layout-collections .product-card__prices {
	display: flex;
	align-items: flex-end;
	flex-wrap: wrap;
	gap: 12px;
}

.layout-collections .product-card__price,
.layout-collections .product-card__price-old {
	font-family: var(--heading-font-family), Georgia, serif;
	font-size: 20px;
	font-weight: 400;
	line-height: 26px;
	letter-spacing: -1.2px;
	white-space: nowrap;
}

.layout-collections .product-card__price {
	color: var(--collection-green);
}

.layout-collections .product-card__price-old {
	color: var(--collection-muted);
	text-decoration: line-through;
}

.layout-collections .product-noloop {
	grid-column: 1 / -1;
}

.layout-collections .collection-alert-no {
	padding: 32px;
	font-size: 16px;
	text-align: center;
	border-radius: 20px;
	background: var(--collection-surface);
}

.layout-collections .collection-pagination {
	margin-top: 58px;
}

.layout-collections #hrv-pagination {
	margin: 0;
}

.layout-collections .hrv-pagination {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 0;
	margin: 0;
	padding: 0;
}

.layout-collections .hrv-pagination-item {
	display: block;
	margin: 0;
}

.layout-collections .hrv-pagination-item-arrow:first-child {
	margin-right: 24px;
}

.layout-collections .hrv-pagination-item-arrow:last-child {
	margin-left: 24px;
}

.layout-collections .hrv-pagination-item > a,
.layout-collections .hrv-pagination-item > span,
.layout-collections .hrv-pagination-item > button {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 40px;
	height: 40px;
	padding: 0 0 1px;
	font-family: var(--base-font-family), Arial, sans-serif;
	font-size: 16px;
	font-weight: 600;
	line-height: 23px;
	letter-spacing: -0.2px;
	color: var(--collection-text);
	border: 0;
	border-radius: 50%;
	background: transparent;
}

.layout-collections .hrv-pagination-item > a:hover,
.layout-collections .hrv-pagination-item > a:focus,
.layout-collections .hrv-pagination-item > button:hover,
.layout-collections .hrv-pagination-item > button:focus,
.layout-collections .hrv-pagination-item > span.current {
	color: #ffffff;
	text-decoration: none;
	background: var(--collection-green-dark);
}

.layout-collections .hrv-pagination-item-arrow > a:hover,
.layout-collections .hrv-pagination-item-arrow > a:focus,
.layout-collections .hrv-pagination-item-arrow > button:hover,
.layout-collections .hrv-pagination-item-arrow > button:focus {
	color: var(--collection-green-dark);
	background: var(--collection-surface);
}

.layout-collections .hrv-pagination-item svg {
	width: 7px;
	height: 12px;
}

.layout-collections .collection-description {
	max-width: 1212px;
	padding: 24px;
	margin: 64px 0 0 auto;
	border: 0;
	border-radius: 20px;
	background: var(--collection-surface);
}

@media (max-width: 1279px) {
	.layout-collections .collection-content > .container {
		width: calc(100% - 48px);
	}

	.layout-collections .col-content {
		grid-template-columns: 260px minmax(0, 1fr);
	}

	.layout-collections .listProduct-row {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.layout-collections .listProduct-row > .product-card {
		height: auto;
	}

	.layout-collections .product-card__body {
		min-height: 142px;
	}
}

@media (max-width: 991px) {
	.layout-collections .collection-hero {
		gap: 16px;
		padding: 32px 16px 0;
	}

	.layout-collections .collection-hero-media {
		border-radius: 12px;
	}

	.layout-collections .collection-hero-title {
		font-size: 36px;
		line-height: 44px;
		letter-spacing: -1.6px;
	}

	.layout-collections .collection-content {
		padding-bottom: 56px;
		margin-top: 0;
	}

	.layout-collections .collection-content > .container {
		width: calc(100% - 32px);
	}

	.layout-collections .col-content {
		display: block;
	}

	/*.layout-collections .col-filter,
	.layout-collections .aside-groupNav {
		display: none;
	}*/

	.layout-collections .col-pro,
	.layout-collections .col-pro.width-full {
		padding-left: 0;
	}

	.layout-collections .filter-icon {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 10px 16px;
		margin-bottom: 0;
		font-size: 14px;
		font-weight: 600;
		color: #ffffff;
		border: 0;
		border-radius: 50px;
		background: linear-gradient(190.57deg, #ccdab9 3.56%, #6f904b 71.86%);
	}

	.layout-collections .filter-icon .icon-filter svg {
		width: 20px;
		height: 20px;
	}

	.layout-collections .filter-icon .icon-right {
		display: none;
	}

	.layout-collections .collection-heading__content {
		margin-bottom: 24px;
	}

	.layout-collections .collection-active-filters {
		flex-wrap: nowrap;
		padding-bottom: 4px;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.layout-collections .collection-active-filters::-webkit-scrollbar {
		display: none;
	}

	.layout-collections .collection-active-filter-tag,
	.layout-collections .collection-clear-filters {
		flex: 0 0 auto;
	}

	.layout-collections .listProduct-row {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px 12px;
	}

	.layout-collections .product-card__body {
		min-height: 118px;
		padding: 12px 4px 0 0;
	}

	.layout-collections .product-card__title {
		min-height: 42px;
		font-size: 14px;
		line-height: 21px;
	}

	.layout-collections .product-card__prices {
		gap: 8px;
	}

	.layout-collections .product-card__price,
	.layout-collections .product-card__price-old {
		font-size: 18px;
		line-height: 24px;
		letter-spacing: -0.8px;
	}

	.layout-collections .collection-pagination {
		margin-top: 40px;
		overflow-x: auto;
	}

	.layout-collections .hrv-pagination-item-arrow:first-child {
		margin-right: 8px;
	}

	.layout-collections .hrv-pagination-item-arrow:last-child {
		margin-left: 8px;
	}

	.layout-collections .wrapper-filter .wrapper_layered_filter {
		height: 100%;
		overflow-y: auto;
		border-radius: 0 20px 20px 0;
	}

	.layout-collections .wrapper-filter .layered_filter_title {
		position: sticky;
		top: 0;
		border-radius: 0 24px 24px 0;
	}

	.layout-collections .wrapper-filter .layered_filter_title .close_filter {
		position: static;
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 40px;
		width: 40px;
		height: 40px;
		padding: 0;
		color: #ffffff;
		border: 0;
		border-radius: 50%;
		background: rgba(66, 89, 47, 0.72);
	}

	.layout-collections .wrapper-filter .collection-filter-count {
		display: none;
	}

	.layout-collections .wrapper-filter .layered_filter_group {
		min-height: calc(100vh - 56px);
		border-radius: 0 20px 20px 0;
	}
}

@media (max-width: 575px) {
	.layout-collections .collection-hero {
		padding-right: 12px;
		padding-left: 12px;
	}

	.layout-collections .collection-hero-title {
		font-size: 30px;
		line-height: 38px;
		letter-spacing: -1.2px;
	}

	.layout-collections .collection-content > .container {
		width: calc(100% - 24px);
	}

	.layout-collections .listProduct-row {
		gap: 20px 8px;
	}

	.layout-collections .product-card__image {
		border-radius: 10px;
	}

	.layout-collections .product-card__price,
	.layout-collections .product-card__price-old {
		font-size: 16px;
		line-height: 22px;
	}

	.layout-collections .hrv-pagination-item > a,
	.layout-collections .hrv-pagination-item > span,
	.layout-collections .hrv-pagination-item > button {
		width: 36px;
		height: 36px;
		font-size: 14px;
	}
}
