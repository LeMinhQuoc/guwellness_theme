{% comment %}haravan-audit:v2{% endcomment %}
{% include 'article-image' with article:article %}
<div class="item-article item-article-style">
  	<div class="media-article">
  		<a href="{{ article.url }}" title="{{ article.title }}" aria-label="{{ article.title }}">
  			<img class="lazyload" data-src="{{ imageUrl | product_img_url : 'grande'}}" alt="{{ article.title }}"
  					 src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="/>
  		</a>	
      <time  datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d Tháng %m, %Y' }}</time>
  	</div>
  	<div class="info-article">
  		<div class="title-article">
  			<h4>
  				<a href="{{ article.url }}">{{ article.title }}</a>
  			</h4>
  		</div>
  		<div class="short-article">
  			{{ article.excerpt_or_content | strip_html | truncatewords: 50 }}
  		</div>
  		<div class="article-action">
  			
  			<div class="view-article">
  				<a class="button button--primary main-button-text" href="{{ article.url }}">
  					Xem thêm
  					<span class="main-button-icon">
              <svg fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                <path d="m7 12h9"></path>
                <path d="m13 16 4-4-4-4"></path>
                </g>
              </svg>
            </span>
  				</a>
  			</div>
  		</div>
  	</div>
  </div>