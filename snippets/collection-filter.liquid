{%- assign checkFilter = false -%}
{%- if settings.collection_filter_show -%} 
{%- assign checkFilter = true -%} 
{%- endif -%}
<div class="wrapper_layered_filter">
	<div class="layered_filter_parent">
		<div class="layered_filter_container">
			<div class="layered_filter_title">
				<div class="title_filter">
					BỘ LỌC
				</div>
				<span class="collection-filter-count" aria-label="{{ collection.products_count }} sản phẩm">{{ collection.products_count }}</span>
				<button class="close_filter" type="button">
					<span class="visually-hidden">Đóng bộ lọc</span>
					<svg width="18" height="18" viewBox="0 0 9.5 9.5" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d="M8.5 1L1 8.5M1 1L8.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</button>
			</div>
			<div class="layered_filter_group layered_filter_mobileContent" id="layered_filter_mobile">
				<!-- ./filter sortby -->
				{% if settings.collection_sortby %}
				<div class="filter_group filter-group-sort filter_sortby" aria-expanded="true">
					<div class="filter_group_block">
						<div class="filter_group-subtitle">
							<span>Sắp xếp</span>
							<svg width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M13 7L7 1L1 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</div>
						<div class="filter_group-content">
							<ul class="checkbox-sortby sort-by-content">									
								<li><span data-value="price-ascending" data-filter="(price:product=asc)">Giá tăng dần</span></li>
								<li><span data-value="price-descending" data-filter="(price:product=desc)">Giá giảm dần</span></li>
								<li><span data-value="title-ascending" data-filter="(title:product=asc)">Từ A-Z</span></li>
								<li><span data-value="title-descending" data-filter="(title:product=desc)">Từ Z-A</span></li>
								<li><span data-value="created-ascending" data-filter="(updated_at:product=asc)">Cũ nhất</span></li>
								<li><span data-value="best-selling" data-filter="(sold_quantity:product=desc)">Bán chạy nhất</span></li>
								<li><span data-value="quantity-descending" data-filter="(quantity:product=desc)">Tồn kho giảm dần</span></li>
							</ul>
						</div>
					</div>
				</div>
				{% endif %}
				{% if settings.show_list_col %}
				<div class="filter_group filter-group-collection" aria-expanded="true" >
					<div class="group-menu filter_group_block">
						<div class="filter_group-subtitle">
							<span>{{settings.title_list_col}}</span>
							<svg width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M13 7L7 1L1 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</div>
						<div class="filter_group-content layered-category" id="filter-col">
							<div class="layered-content">
								<ul class="tree-menu">
									{%- assign collection_sidebar_handle = settings.collection_sidebar -%}
									{%- assign collection_sidebar = linklists[collection_sidebar_handle] -%}
									{%- assign collection_sidebar_links = collection_sidebar.links -%}
									{% for link in collection_sidebar_links limit: 10 %}
									{%- assign child_linklist_handle = link.handle -%}
									{%- assign child_linklist = linklists[child_linklist_handle] -%}
									{% if child_linklist != empty %}
									<li class="tree-menu-lv1{% if link.active %} active {% endif %} has-child {% if forloop.first %} menu-uncollap {% else %} menu-collap {% endif %}">
										<a class="{% if link.active %} active {% endif %}" href="javascript:void(0)" title="{{ link.title }}" target="_self">
											<span class="">{{ link.title }}</span>
											<span class="icon-control"><i class="fa fa-minus"></i></span>
										</a>
										<ul class="tree-menu-sub">
											{% for l in child_linklist.links %}
											<li>
												<span></span>
												<a href="{{ l.url }}"{% if l.active %} class="current"{% endif %} title="{{l.title}}">{{ l.title }}</a>
											</li>
											{% endfor %}
										</ul>
									</li>
									{% else %}
									<li class="{% if link.active %}active{% endif %}">
										<span></span>
										<a class="{% if link.active %} current{% endif %}" href="{{ link.url }}" title="{{ link.title }}" target="_self">
											{{link.title}}
										</a>
									</li>
									{% endif %}
									{% endfor %}
								</ul>
							</div>
						</div>
					</div>
				</div>
				{% endif %}
				{% if checkFilter %}
				<!-- ./filter brand -->
				{%- assign vendor_filter_values = settings.vendor_filter_values | split: ',' -%}
				{% if settings.use_vendor_filter and settings.vendor_filter_values != blank %}
				<div class="filter_group filter-group-vendor" aria-expanded="true" >
					<div class="filter_group_block">
						<div class="filter_group-subtitle">
							<span>{{settings.vendor_title}}</span>
							<svg width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M13 7L7 1L1 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</div>
						<div class="filter_group-content filter-brand" id="filter-brand">
							<ul class="checkbox-list">
								{% for vendor_item in vendor_filter_values limit: settings.vendor_limit %}
								{%- assign vendor = vendor_item | strip -%}
								{% if vendor != blank %}
								<li>
									<input type="checkbox" id="data-brand-p{{forloop.index}}" value="{{ vendor | escape }}" name="brand-filter" data-vendor="(vendor:product contains {{ vendor | replace: '-', '' | escape }})"/>
									<label for="data-brand-p{{forloop.index}}">{{ vendor | escape }}</label>
								</li>
								{% endif %}
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
				{% endif %}
        <!-- ./filter type -->
				{%- assign type_filter_values = settings.type_filter_values | split: ',' -%}
				{% if settings.use_type_filter and settings.type_filter_values != blank %}
				<div class="filter_group filter-group-type" aria-expanded="true" >
					<div class="filter_group_block">
						<div class="filter_group-subtitle">
							<span>{{settings.type_title}}</span>
							<svg width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M13 7L7 1L1 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</div>
						<div class="filter_group-content filter-type">
							<ul class="checkbox-list">
								{% for type_item in type_filter_values limit: settings.type_limit %}
								{%- assign type = type_item | strip -%}
								{% if type != blank %}
								<li>
									<input type="checkbox" id="data-type-p{{forloop.index}}" value="{{ type | escape }}" name="type-filter" data-type="(product_type:product={{ type | replace: '-', '' | escape }})"/>
									<label for="data-type-p{{forloop.index}}">{{ type | escape }}</label>
								</li>
								{% endif %}
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
				{% endif %}
				<!-- ./filter tag -->
				{%- assign tag_filter_values = settings.enter_tag_3 | split: ',' -%}
				{% if settings.use_tag_custom_3 and settings.enter_tag_3 != blank %}
				<div class="filter_group filter-group-tag" aria-expanded="true" >
					<div class="filter_group_block">
						<div class="filter_group-subtitle">
							<span>{{ settings.tag_title_custom_3 }}</span>
							<svg width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M13 7L7 1L1 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</div>
						<div class="filter_group-content filter-tag" id="filter-tag">
							<ul class="checkbox-list">
								{% for tag_item in tag_filter_values %}
								{%- assign tag = tag_item | strip -%}
								{% if tag != blank %}
								<li>
									<input type="checkbox" id="data-tag-p{{forloop.index}}" value="{{ tag | escape }}" name="tag-filter" data-tag="(tag:product={{ tag | escape }})"/>
									<label for="data-tag-p{{forloop.index}}">{{ tag | escape }}</label>
								</li>
								{% endif %}
								{% endfor %}
							</ul>
						</div>
					</div>
				</div>
				{% endif%}
				<!-- ./filter price -->
				{% if settings.use_price_filter %}
				<div class="filter_group filter-group-price" aria-expanded="true" >
					<div class="filter_group_block">
						<div class="filter_group-subtitle">
							<span>Khoảng giá</span>
							<svg width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M13 7L7 1L1 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</div>
						<div class="filter_group-content hrv-price collection-price-filter" id="hrv-price" data-range-min="0" data-range-max="{{settings.1_price_to}}">
							<div class="collection-price-selected">
								<span class="collection-price-selected-min">{{ 0 | money }}</span>
								<span aria-hidden="true">-</span>
								<span class="collection-price-selected-max">{{settings.1_price_to |  times: 100 | money}}</span>
							</div>
							<div class="collection-price-range">
								<div class="collection-price-track"></div>
								<div class="collection-price-progress"></div>
								<input class="collection-price-input collection-price-input-min" type="range" min="0" max="{{settings.1_price_to}}" step="1000" value="0" aria-label="Giá thấp nhất">
								<input class="collection-price-input collection-price-input-max" type="range" min="0" max="{{settings.1_price_to}}" step="1000" value="{{settings.1_price_to}}" aria-label="Giá cao nhất">
							</div>
							<div class="collection-price-bounds" aria-hidden="true">
								<span>{{ 0 | money }}</span>
								<span>{{settings.1_price_to |  times: 100 | money}}</span>
							</div>
						</div>
					</div>
				</div>
				{% endif %}	
				<!-- ./filter color -->
				{% if settings.use_color_filter %}
				<div class="filter_group filter-group-color" aria-expanded="true" >
					<div class="filter_group_block">
						<div class="filter_group-subtitle">
							<span>{{settings.color_title}}</span>
							<svg width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M13 7L7 1L1 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</div>
						<div class="filter_group-content filter-color">
							<ul class="checkbox-list clearfix">
								{% for i in (1..20) %}
								{% capture use_color %}use_color_filter_{{i}}{% endcapture %}
								{% capture color_name %}color_name_new_{{i}}{% endcapture %}
								{% capture color_code %}color_code_new_{{i}}{% endcapture %}
								{% capture value %}{{settings[color_name]}}{% endcapture %}
								{% if settings[use_color]%}
								{%- assign color_value = settings[color_code] -%}
								<li>
									<input type="checkbox" id="data-color-p{{forloop.index}}" value="{{value}}" name="color-filter" data-color="(variant:product contains {{value}})"/>
									<label for="data-color-p{{forloop.index}}" style="background-color: {{ color_value }}">{{settings[color_name]}}</label>
								</li>
								{% endif %}
								{% endfor %}	
							</ul>
						</div>
					</div>
				</div>
				{% endif %}
				{%-comment-%}<div class="filter_group d-none d-lg-block" aria-expanded="false" >
				<div class="filter_group_block">
					<button class="btn-collection btn_clear_filter">
						Xóa bộ chọn
					</button>
				</div>
				</div> {%-endcomment-%}
				{% endif %}

			</div>
			<div class="layered_filter_bottom">
				<button id="clear-btn-filter" class="btn-filter btn-filter-clear">Hủy</button>
				<button id="apply-btn-filter" class="btn-filter btn-filter-apply">Áp dụng</button>
			</div>
		</div>
	</div>
</div>
