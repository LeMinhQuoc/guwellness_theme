{% comment %}haravan-audit:v2{% endcomment %}
<link rel="preload stylesheet" href="{{ 'footer.scss.css' | asset_url }}" as="style">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'footer.js' | asset_url }}"></script>
{% if settings.gu_footer_newsletter_show %}
{%- capture formFooter -%}
  {%- form 'customer' -%}
    {%- if form.posted_successfully? -%}<p id="dentalhub-newsletter-success" class="d-none popup-form-success success">Cám ơn bạn đã đăng ký email theo dõi!</p>{% endif %}
    <div class="form-group input-group">
      <input type="hidden" id="dentalhub-newsletter-tags" name="contact[tags]" value="Đăng kí nhận tin" />
      <input required type="email" name="contact[email]" class="form-control dentalhub-newsletter-input" id="dentalhub-newsletter-email" pattern="^(.)+@[A-Za-z0-9]([A-Za-z0-9.\\-]*[A-Za-z0-9])?\.[A-Za-z]{1,13}$" placeholder="Nhập email của bạn" aria-label="Email Address">
      <div class="btn-more input-group-btn">
        <button type="submit" class="button btn-icon dark cta-submitform gu-btn">
            <span class="gu-btn__icon" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M0 1.827L1.71 0H10V8.22L8.11 10V5.93C8.11 4.938 8.119 4.04 8.14 3.235L1.498 9.815L0.182 8.375L6.823 1.795C6.036 1.817 5.153 1.827 4.176 1.827H0Z" fill="currentColor"></path></svg></span>
            <span class="gu-btn__label">Xem thêm</span>
        </button>
        </div>
    </div>
    <div class="sitebox-recaptcha d-none">
      This site is protected by reCAPTCHA and the Google
      <a href="https://policies.google.com/privacy" target="_blank" rel="noreferrer">Privacy Policy</a>
      and <a href="https://policies.google.com/terms" target="_blank" rel="noreferrer">Terms of Service</a> apply.
    </div>
  {%- endform -%}
{%- endcapture -%}
<section class="newsletter">
  <div class="container-fluid">
    <div class="newsletter__inner">
      <h2 class="newsletter__title">{{ settings.gu_footer_newsletter_title }}</h2>
      <div class="newsletter__form dentalhub-newsletter-form">
        {{ formFooter | replace: 'script', 'noscript' | replace: 'noscript src=', 'noscript data-src=' }}
      </div>
    </div>
  </div>
</section>
{% endif %}

<footer class="site-footer">
  <div class="container-fluid">
  <div class="site-footer__background p-5">
      <div class="site-footer__grid row">
        <div class="site-footer__brand col-md-6 col-12">
          <a href="{{shop.url}}" class="gu-footer-logo mb-4">
            <img src="{{ settings.fot_logo_png }}" />
          </a>
          <p class="site-footer__name">{{ settings.gu_footer_brand_name }}</p>
          <p class="site-footer__text"><strong>Địa chỉ:</strong> {{ settings.gu_footer_address }}</p>
          <p class="site-footer__contact">
            <svg width="20" height="20" viewBox="0 0 20.6055 20.6055" fill="none" aria-hidden="true"><path d="M6.45059 7.29866C7.14659 8.74828 8.09537 10.1069 9.29695 11.3085C10.4985 12.5101 11.8572 13.4589 13.3068 14.1549C13.4315 14.2147 13.4938 14.2447 13.5727 14.2677C13.8531 14.3494 14.1973 14.2907 14.4348 14.1207C14.5016 14.0728 14.5587 14.0157 14.673 13.9014C15.0226 13.5518 15.1975 13.377 15.3732 13.2627C16.0361 12.8317 16.8907 12.8317 17.5536 13.2627C17.7294 13.377 17.9042 13.5518 18.2538 13.9014L18.4486 14.0962C18.9801 14.6277 19.2458 14.8934 19.3902 15.1788C19.6772 15.7463 19.6772 16.4166 19.3902 16.9842C19.2458 17.2695 18.9801 17.5353 18.4486 18.0667L18.291 18.2243C17.7614 18.754 17.4966 19.0188 17.1365 19.221C16.737 19.4455 16.1165 19.6068 15.6583 19.6054C15.2454 19.6042 14.9632 19.5241 14.3987 19.3639C11.3653 18.5029 8.50295 16.8785 6.11497 14.4905C3.72699 12.1025 2.10252 9.24014 1.24155 6.20675C1.08134 5.6423 1.00124 5.36008 1.00001 4.94713C0.998645 4.48891 1.16001 3.86842 1.38443 3.46891C1.58667 3.10888 1.85149 2.84407 2.38111 2.31445L2.53874 2.15681C3.07019 1.62537 3.33591 1.35965 3.62129 1.2153C4.18885 0.928232 4.85912 0.928232 5.42668 1.2153C5.71206 1.35965 5.97778 1.62537 6.50922 2.15681L6.70409 2.35168C7.0537 2.70129 7.2285 2.87609 7.34279 3.05187C7.77378 3.71476 7.77378 4.56934 7.34278 5.23223C7.2285 5.40801 7.0537 5.58281 6.70409 5.93242C6.58978 6.04673 6.53262 6.10388 6.48478 6.1707C6.31477 6.40813 6.25607 6.75239 6.33779 7.03274C6.36079 7.11163 6.39072 7.17397 6.45059 7.29866Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
            <span>{{ settings.gu_footer_phone }}</span>
          </p>
          <p class="site-footer__contact">
            <svg width="22" height="18" viewBox="0 0 22.0002 18" fill="none" aria-hidden="true"><path d="M20.5001 15L13.8572 9M8.14294 9L1.50012 15M1.00009 4L9.165 9.71544C9.82618 10.1783 10.1568 10.4097 10.5163 10.4993C10.834 10.5785 11.1662 10.5785 11.4838 10.4993C11.8434 10.4097 12.174 10.1783 12.8352 9.71545L21.0001 4M5.80009 17H16.2001C17.8802 17 18.7203 17 19.3621 16.673C19.9265 16.3854 20.3855 15.9265 20.6731 15.362C21.0001 14.7202 21.0001 13.8802 21.0001 12.2V5.8C21.0001 4.11984 21.0001 3.27976 20.6731 2.63803C20.3855 2.07354 19.9265 1.6146 19.3621 1.32698C18.7203 1 17.8802 1 16.2001 1H5.80009C4.11993 1 3.27985 1 2.63811 1.32698C2.07363 1.6146 1.61469 2.07354 1.32707 2.63803C1.00009 3.27976 1.00009 4.11984 1.00009 5.8V12.2C1.00009 13.8802 1.00009 14.7202 1.32707 15.362C1.61469 15.9265 2.07363 16.3854 2.63811 16.673C3.27985 17 4.11993 17 5.80009 17Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
            <span>{{ settings.gu_footer_email }}</span>
          </p>
        </div>
        <div class="site-footer__link col-md-6 col-12">
          <div class="row">
          {% for i in (1..3)  %}
            {% capture showftmenu %}gu_footer_menu_{{i}}_title{% endcapture %}
            {% capture titleftmenu %}gu_footer_menu_{{i}}_title{% endcapture %}
            {% capture setftmenu %}gu_footer_menu_{{i}}{% endcapture %}
            {% if settings[showftmenu] %}
            {% assign setftmenuG = settings[setftmenu] %}
            <nav class="site-footer__col col-md-6 col-12" aria-label="{{ settings[titleftmenu] }}">
              <h2 class="site-footer__heading">{{ settings[titleftmenu] }}</h2>
              {% for link in linklists[setftmenuG].links %}
                <a class="site-footer__link" href="{{ link.url }}">{{ link.title }}</a>
              {% endfor %}
            </nav>
            {% endif %}
          {%  endfor %}
          
            <div class="col-md-6 col-12">
              {% if settings.dentalhub_footer_social_link_show %}
              <nav class="site-footer__col footer__col-social">
                <h2 class="site-footer__heading">{{ settings.dentalhub_footer_social_link_title }}</h2>
                <ul>
                  {% if settings.dentalhub_footer_social_link_facebook %}
                    <li>
                      <a class="site-footer__link" href="{{ settings.dentalhub_footer_social_link_facebook }}">
                        <img src="{{ 'facebook.png' | asset_url }}" />
                      </a>
                    </li>
                  {% endif %}
                  {% if settings.dentalhub_footer_social_link_youtube %}
<li>
                    <a class="site-footer__link" href="{{ settings.dentalhub_footer_social_link_youtube }}">
                      <img src="{{ 'youtube.png' | asset_url }}" />
                    </a>
                    </li>
                  {% endif %}
                  {% if settings.dentalhub_footer_social_link_tiktok %}
<li>
                    <a class="site-footer__link" href="{{ settings.dentalhub_footer_social_link_tiktok }}">
                      <img src="{{ 'tiktok.png' | asset_url }}" />
                    </a>
                    </li>
                  {% endif %}
                  {% if settings.dentalhub_footer_social_link_instagram %}
<li>
                    <a class="site-footer__link" href="{{ settings.dentalhub_footer_social_link_instagram }}">
                      <img src="{{ 'instagram.png' | asset_url }}" />
                    </a>
                    </li>
                  {% endif %}
                </ul>
              </nav>
              {% endif %}
              {%if settings.fot_bct_show%}
                <a target="_blank" class="d-block mt-4" href="{{settings.fot_bct_link}}"><img style="height: 40px;" src="{{'fot_bct_logo.png' | asset_url}}"/></a>
              {%endif%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
