{% comment %}haravan-audit:v2{% endcomment %}
{% if settings.gu_index_product_cards_show %}
<link rel="preload stylesheet" href="{{ 'gu-index-product-cards.scss.css' | asset_url }}" as="style">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'gu-index-product-cards.js' | asset_url }}"></script>

<section class="product-grid my-5 pt-0 container-gu reveal gu-index-product-cards" id="products" data-filename="gu-index-product-cards">
  <div class="container-fluid">
    <h2 class="section-title text-center mb-5">Bộ sưu tập dinh dưỡng</h2>
    <div class="row owl-carousel">
      {% for product in collections[settings.gu_index_product_cards_collection].products limit: settings.gu_index_product_cards_count  %}
      <div class="col-6 col-md-3 item-owl">
        {% include 'product-loop' %}
      </div>
      {% endfor %}
    </div>
    <div class="d-flex justify-content-center mt-4">
      <a class="gu-btn" href="/collections/{{settings.gu_index_product_cards_collection}}">
        <span class="gu-btn__icon" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M0 1.827L1.71 0H10V8.22L8.11 10V5.93C8.11 4.938 8.119 4.04 8.14 3.235L1.498 9.815L0.182 8.375L6.823 1.795C6.036 1.817 5.153 1.827 4.176 1.827H0Z" fill="currentColor"/></svg></span>
        <span class="gu-btn__label">Xem thêm</span>
      </a>
    </div>
  </div>
</section>
{% endif %}
