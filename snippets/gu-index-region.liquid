{% comment %}haravan-audit:v2{% endcomment %}
{% if settings.gu_index_region_show %}
<link rel="preload stylesheet" href="{{ 'gu-index-region.scss.css' | asset_url }}" as="style">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'gu-index-region.js' | asset_url }}"></script>

<section class="region-scroll js-region-scroll" id="regions" data-filename="gu-index-region">
  <div class="pin-frame region"{% unless settings.gu_index_region_bg_image_url == blank %} style="--region-bg-image: url('{{ settings.gu_index_region_bg_image_url }}');"{% endunless %}>
    <div class="region__bg" aria-hidden="true">
      {% unless settings.gu_index_region_bg_image_url == blank %}
      <img class="obj-cover obj-center" src="{{ settings.gu_index_region_bg_image_url }}" alt="">
      {% endunless %}
    </div>

    <div class="region__content">
      <div>
        {% unless settings.gu_index_region_eyebrow == blank %}
        <p class="region__eyebrow">{{ settings.gu_index_region_eyebrow }}</p>
        {% endunless %}
        {% unless settings.gu_index_region_title == blank %}
        <h2 class="region__title">{{ settings.gu_index_region_title }}</h2>
        {% endunless %}
        {% unless settings.gu_index_region_button == blank %}
        <a class="gu-btn" href="{{ settings.gu_index_region_button_link }}">
          <span class="gu-btn__icon" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M0 1.827L1.71 0H10V8.22L8.11 10V5.93C8.11 4.938 8.119 4.04 8.14 3.235L1.498 9.815L0.182 8.375L6.823 1.795C6.036 1.817 5.153 1.827 4.176 1.827H0Z" fill="currentColor"/></svg></span>
          <span class="gu-btn__label">{{ settings.gu_index_region_button }}</span>
        </a>
        {% endunless %}
      </div>
    </div>

    <div class="region__cards">
      <div class="region__cards-grid">
        {% if settings.gu_index_region_card_1_show %}
        <article class="category-card">
          <div class="category-card__inner">
            {% unless settings.gu_index_region_card_1_image_url == blank %}
            <div class="category-card__image"><img class="obj-contain" src="{{ settings.gu_index_region_card_1_image_url | img_url: 'medium' }}" alt="{{ settings.gu_index_region_card_1_title | escape }}"></div>
            {% endunless %}
            {% unless settings.gu_index_region_card_1_title == blank %}
            <h3 class="category-card__title">{{ settings.gu_index_region_card_1_title }}</h3>
            {% endunless %}
          </div>
        </article>
        {% endif %}

        {% if settings.gu_index_region_card_2_show %}
        <article class="category-card">
          <div class="category-card__inner">
            {% unless settings.gu_index_region_card_2_image_url == blank %}
            <div class="category-card__image"><img class="obj-contain" src="{{ settings.gu_index_region_card_2_image_url | img_url: 'medium' }}" alt="{{ settings.gu_index_region_card_2_title | escape }}"></div>
            {% endunless %}
            {% unless settings.gu_index_region_card_2_title == blank %}
            <h3 class="category-card__title">{{ settings.gu_index_region_card_2_title }}</h3>
            {% endunless %}
          </div>
        </article>
        {% endif %}

        {% if settings.gu_index_region_card_3_show %}
        <article class="category-card">
          <div class="category-card__inner">
            {% unless settings.gu_index_region_card_3_image_url == blank %}
            <div class="category-card__image"><img class="obj-contain" src="{{ settings.gu_index_region_card_3_image_url | img_url: 'medium' }}" alt="{{ settings.gu_index_region_card_3_title | escape }}"></div>
            {% endunless %}
            {% unless settings.gu_index_region_card_3_title == blank %}
            <h3 class="category-card__title">{{ settings.gu_index_region_card_3_title }}</h3>
            {% endunless %}
          </div>
        </article>
        {% endif %}

        {% if settings.gu_index_region_card_4_show %}
        <article class="category-card">
          <div class="category-card__inner">
            {% unless settings.gu_index_region_card_4_image_url == blank %}
            <div class="category-card__image"><img class="obj-contain" src="{{ settings.gu_index_region_card_4_image_url | img_url: 'medium' }}" alt="{{ settings.gu_index_region_card_4_title | escape }}"></div>
            {% endunless %}
            {% unless settings.gu_index_region_card_4_title == blank %}
            <h3 class="category-card__title">{{ settings.gu_index_region_card_4_title }}</h3>
            {% endunless %}
          </div>
        </article>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endif %}
