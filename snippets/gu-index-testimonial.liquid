{% comment %}haravan-audit:v2{% endcomment %}
{% if settings.gu_index_testimonial_show %}
<link rel="preload stylesheet" href="{{ 'gu-index-testimonial.scss.css' | asset_url }}" as="style">
<script fetchpriority="low" type="text/javascript" defer src="{{ 'gu-index-testimonial.js' | asset_url }}"></script>

<section class="section-pad-sm gu-index-testimonial" data-filename="gu-index-testimonial">
  <div class="testimonial reveal">
    <div class="container-fluid">
      <div class="d-flex flex-column flex-md-row g-48 align-items-center">
        <div class="testimonial__videos">
          <div class="testimonial__video" data-testimonial-video>
            <img class="testimonial__image obj-cover ratio-video" src="{{ settings.gu_index_testimonial_image_1 }}" alt="{{ settings.gu_index_testimonial_image_1_alt | escape }}">
            {% if settings.gu_index_testimonial_video_1 != blank %}
            <video id="gu-testimonial-video-1" class="testimonial__player obj-cover ratio-video" src="{{ settings.gu_index_testimonial_video_1 | escape }}" preload="metadata" muted playsinline></video>
            <button class="testimonial__play" type="button" data-testimonial-play aria-controls="gu-testimonial-video-1" aria-label="Phát video đánh giá 1" aria-pressed="false">
              <svg class="testimonial__play-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M6 3.5L16 10L6 16.5V3.5Z" fill="currentColor"/></svg>
              <svg class="testimonial__pause-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 4H8V16H5V4ZM12 4H15V16H12V4Z" fill="currentColor"/></svg>
            </button>
            {% endif %}
          </div>
          <div class="testimonial__video" data-testimonial-video>
            <img class="testimonial__image obj-cover ratio-video" src="{{ settings.gu_index_testimonial_image_2 }}" alt="{{ settings.gu_index_testimonial_image_2_alt | escape }}">
            {% if settings.gu_index_testimonial_video_2 != blank %}
            <video id="gu-testimonial-video-2" class="testimonial__player obj-cover ratio-video" src="{{ settings.gu_index_testimonial_video_2 | escape }}" preload="metadata" muted playsinline></video>
            <button class="testimonial__play" type="button" data-testimonial-play aria-controls="gu-testimonial-video-2" aria-label="Phát video đánh giá 2" aria-pressed="false">
              <svg class="testimonial__play-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M6 3.5L16 10L6 16.5V3.5Z" fill="currentColor"/></svg>
              <svg class="testimonial__pause-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 4H8V16H5V4ZM12 4H15V16H12V4Z" fill="currentColor"/></svg>
            </button>
            {% endif %}
          </div>
          <div class="testimonial__video" data-testimonial-video>
            <img class="testimonial__image obj-cover ratio-video" src="{{ settings.gu_index_testimonial_image_3 }}" alt="{{ settings.gu_index_testimonial_image_3_alt | escape }}">
            {% if settings.gu_index_testimonial_video_3 != blank %}
            <video id="gu-testimonial-video-3" class="testimonial__player obj-cover ratio-video" src="{{ settings.gu_index_testimonial_video_3 | escape }}" preload="metadata" muted playsinline></video>
            <button class="testimonial__play" type="button" data-testimonial-play aria-controls="gu-testimonial-video-3" aria-label="Phát video đánh giá 3" aria-pressed="false">
              <svg class="testimonial__play-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M6 3.5L16 10L6 16.5V3.5Z" fill="currentColor"/></svg>
              <svg class="testimonial__pause-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 4H8V16H5V4ZM12 4H15V16H12V4Z" fill="currentColor"/></svg>
            </button>
            {% endif %}
          </div>
        </div>
        <div class="testimonial__content">
          <div class="testimonial__stars" aria-label="{{ settings.gu_index_testimonial_review_label | escape }}">
            <span class="testimonial__star">★</span><span class="testimonial__star">★</span><span class="testimonial__star">★</span><span class="testimonial__star">★</span><span class="testimonial__star">★</span>
            <span class="fs-16 ml-2">{{ settings.gu_index_testimonial_review_text }}</span>
          </div>
          <h2 class="section-title">{{ settings.gu_index_testimonial_title }}</h2>
          <p class="testimonial__copy">{{ settings.gu_index_testimonial_desc }}</p>
          <a class="gu-btn" href="{{ settings.gu_index_testimonial_link }}">
            <span class="gu-btn__icon" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M0 1.827L1.71 0H10V8.22L8.11 10V5.93C8.11 4.938 8.119 4.04 8.14 3.235L1.498 9.815L0.182 8.375L6.823 1.795C6.036 1.817 5.153 1.827 4.176 1.827H0Z" fill="currentColor"/></svg></span>
            <span class="gu-btn__label">{{ settings.gu_index_testimonial_btn }}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}
