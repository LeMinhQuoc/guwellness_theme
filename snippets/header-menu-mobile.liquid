{% comment %}haravan-audit:v2{% endcomment %}
<div class="dentalhub-sitenav-wrapper dentalhub-sitenav-left dentalhub-sitenav-menu">
	<div class="dentalhub-sitenav-inner">
		<div class="dentalhub-sitenav-header">

			<a name="button-close" class="dentalhub-sitenav-header__btn dentalhub-btn-sitenav-close">
				<svg viewBox="0 0 19 19" role="presentation"><path d="M9.1923882 8.39339828l7.7781745-7.7781746 1.4142136 1.41421357-7.7781746 7.77817459 7.7781746 7.77817456L16.9705627 19l-7.7781745-7.7781746L1.41421356 19 0 17.5857864l7.7781746-7.77817456L0 2.02943725 1.41421356.61522369 9.1923882 8.39339828z" fill-rule="evenodd"></path></svg>
			</a>
     
		</div>
		<div class="dentalhub-sitenav-content">
			<div class="dentalhub-menu-mobile--wrap">
				<ul class="dentalhub-menuList-links">
					{% for link in linklists[settings.dentalhub_mainmenu_link].links limit: 10 %}
					{% if linklists[link.handle].links == empty %}				
					<li class="{% if link.active %} active{% endif %}"><a href="{{link.url}}" title="{{link.title}}"><span>{{link.title}}</span></a></li>
					{% else %}
					<li class="dentalhub-has-submenu dentalhub-level0 {% if link.active %} active{% endif %}">
						<a href="{{ link.url }}" title="{{link.title}}">{{ link.title }} <span class="dentalhub-icon-plus-submenu dentalhub-plus-nClick1"></span></a>
						<ul class="dentalhub-submenu-links">
							{% for link2 in linklists[link.handle].links %}
							{% if linklists[link2.handle].links == empty %}
							<li><a href="{{ link2.url }}" title="{{link2.title}}">{{ link2.title }}</a></li>
							{% else %}
							<li class="dentalhub-has-submenu dentalhub-level1">
								<a href="{{ link2.url }}">{{ link2.title }}  <span class="dentalhub-icon-plus-submenu dentalhub-plus-nClick2"></span></a>
								<ul class="dentalhub-submenu-links" >
									{% for link3 in linklists[link2.handle].links %}						
									<li class=""><a href="{{ link3.url }}" title="{{link3.title}}" >{{ link3.title }}</a></li>
									{% endfor %}
								</ul>
							</li>
							{% endif %}
							{% endfor %}
						</ul>
					</li>
					{% endif %}
					{% endfor%}
				</ul>	
			</div>
		</div>
		{% if shop.customer_accounts_enabled and settings.show_dentalhub_header_account %}
		<div class="hrv-sitenav-footer dentalhub-menu-mobile-account">
			<a class="dentalhub-menu-mobile-account-link" href="{% if customer %}/account{% else %}/account/login{% endif %}" aria-label="Tài khoản" title="Tài khoản">
				<svg width="20" height="19" viewBox="0 0 20 19" fill="none" aria-hidden="true"><path d="M1 18C3.33579 15.5226 6.50702 14 10 14C13.493 14 16.6642 15.5226 19 18M14.5 5.5C14.5 7.98528 12.4853 10 10 10C7.51472 10 5.5 7.98528 5.5 5.5C5.5 3.01472 7.51472 1 10 1C12.4853 1 14.5 3.01472 14.5 5.5Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
				<span>Tài khoản</span>
			</a>
		</div>
		{% endif %}
		
	</div>
	<div class="dentalhub-sidebar-overlay"></div>
</div>
