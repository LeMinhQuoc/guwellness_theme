
<div id="fake-order-popup">  <div class="popup-content">
    <img id="popup-img" src="{{'no-image.png' | asset_url}}" alt="Sale Popup" loading="lazy" decoding="async">
    <div class="popup-text">
      <p><strong id="popup-name"></strong> vừa mua</p>
      <p id="popup-product"></p>
      <span id="popup-time"></span>
    </div>
  </div>
</div>
<script defer>
  var haravanProducts = [
    {% for product in collections[settings.sale_popup_collection_picker].products limit: 20 %}
      {
        name: "{{ product.title }}",
        img: "{{ product.featured_image | img_url: 'small' }}",
        url: "{{ product.url }}"
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
</script>
<style>
    #fake-order-popup {
        position: fixed;
        top: auto !important;
        bottom: 20px;
        left: 20px;
        width: 300px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        padding: 10px;
        z-index: 9;
        transform: translateX(-120%);
        opacity: 0;
        visibility: hidden;
        transition: all 0.5s ease;
        }

        #fake-order-popup.show {
        transform: translateX(0);
        opacity: 1;
        visibility: visible;
        }

        .popup-content {
        display: flex;
        align-items: center;
        }

        .popup-content img {
        width: 55px;
        height: 55px;
        border-radius: 8px;
        margin-right: 10px;
        }

        .popup-text p {
        margin: 0;
        font-size: 14px;
        }

        #popup-product {
        font-weight: 500;
        color: #333;
        }

        #popup-time {
        font-size: 12px;
        color: #888;
        }
</style>
<script defer>
    $(document).ready(function () {
  var names = [
    {%assign arrs_name = settings.sale_popup_customers | split: ','%}
     {%for name in arrs_name%}
      "{{name}}"{% unless forloop.last %},{% endunless %}   
    {%endfor%}
  ];
  var messages = [
    {%assign arrs_time = settings.sale_popup_time_ago | split: ','%}
     {%for time in arrs_time%}
      "{{time}}"{% unless forloop.last %},{% endunless %}   
    {%endfor%}
  ];
  function randomItem(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
  }
  var popupCount = parseInt(sessionStorage.getItem("popupCount")) || 0;
  var maxPopup = {% if settings.sale_popup_count_show > 0 %}{{settings.sale_popup_count_show | plus: 0 }}{% else %}20{% endif %};
  function showPopup() {
    if (popupCount >= maxPopup) return false;
    if (!haravanProducts.length) return;
    var product = randomItem(haravanProducts);
    var name = randomItem(names);
    var message = randomItem(messages);
    $("#fake-order-popup #popup-img").attr("src", product.img);
    $("#fake-order-popup #popup-name").text(name);
    $("#fake-order-popup #popup-product").text(product.name);
    $("#fake-order-popup #popup-time").text(message);
    $("#fake-order-popup").addClass("show");
    popupCount++;
    sessionStorage.setItem("popupCount", popupCount);
    setTimeout(function () {
      $("#fake-order-popup").removeClass("show");
    }, {{settings.sale_popup_time_delay_popup}});
  }
  if (popupCount < maxPopup) {
    setTimeout(function () {
      showPopup();
    }, 5000);
    var interval = setInterval(function () {
      if (popupCount >= maxPopup) {
        clearInterval(interval); 
        return;
      }
      showPopup();
    }, Math.floor(Math.random() * 500) + {{settings.sale_popup_time_delay_between}});
  }
});



</script>