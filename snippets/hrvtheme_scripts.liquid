    plusQuantity: function($this) {
      const $parent = $($this).parent();
  		if ( $parent.find('input[name="quantity"]').val() != undefined ) {
  			var currentVal = parseInt($parent.find('input[name="quantity"]').val());
  			if (!isNaN(currentVal)) {
  				$parent.find('input[name="quantity"]').val(currentVal + 1);
  			} else {
  				$parent.find('input[name="quantity"]').val(1);
  			}
  
  		}else {
  			console.log('error: Not see elemnt ' + jQuery('input[name="quantity"]').val());
  		}
  	},
    minusQuantity: function($this) {
      const $parent = $($this).parent();
      if ($parent.find('input[name="quantity"]').val() != undefined ) {
        var currentVal = parseInt($parent.find('input[name="quantity"]').val());
        if (!isNaN(currentVal) && currentVal > 1) {
          $parent.find('input[name="quantity"]').val(currentVal - 1);
        }
      }else {
        console.log('error: Not see elemnt ' + $parent.find('input[name="quantity"]').val());
      }
