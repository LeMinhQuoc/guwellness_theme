<link rel="stylesheet" href="{{ 'popup-ctv-register.scss.css' | asset_url }}">

<div class="ctv-popup-overlay" data-farmtour-popup-overlay aria-hidden="true">
  <div class="ctv-popup" role="dialog" aria-modal="true" aria-labelledby="farmtourPopupTitle">
    <button type="button" class="ctv-popup-close" data-farmtour-popup-close aria-label="Đóng">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
    <h2 id="farmtourPopupTitle">{{ settings.page_vnl_farmtour_popup_title | newline_to_br }}</h2>
    <form class="ctv-popup-form" data-farmtour-popup-form action="{{ settings.page_vnl_farmtour_popup_form_action }}" method="POST">
      <input type="hidden" name="{{ settings.page_vnl_farmtour_popup_entry_type }}" value="Farm Tour" />

      <div class="ctv-popup-section">
        <p class="ctv-popup-label">Thông tin cá nhân</p>
        <input type="text" name="{{ settings.page_vnl_farmtour_popup_entry_fullname }}" placeholder="Họ và tên *" required />
        <div class="ctv-popup-row">
          <input type="tel" name="{{ settings.page_vnl_farmtour_popup_entry_phone }}" placeholder="SĐT liên hệ *" required />
          <input type="email" name="{{ settings.page_vnl_farmtour_popup_entry_email }}" placeholder="VD:info@email.com" />
        </div>
      </div>

      <div class="ctv-popup-section">
        <p class="ctv-popup-label">Thông tin chuyến tham quan :</p>
        <div class="ctv-popup-row">
          <input type="text" inputmode="numeric" pattern="[1-9][0-9]*" name="{{ settings.page_vnl_farmtour_popup_entry_guests }}" placeholder="Số lượng người tham gia *" required />
          <input type="text" class="ctv-popup-date" name="{{ settings.page_vnl_farmtour_popup_entry_tour_date }}" placeholder="Ngày mong muốn tham quan *" required />
        </div>
        <select name="{{ settings.page_vnl_farmtour_popup_entry_province }}" required class="ctv-popup-select-placeholder" data-vn-province data-placeholder="Tỉnh/Thành phố *">
          <option value="" selected disabled>Tỉnh/Thành phố *</option>
        </select>
      </div>

      <div class="ctv-popup-section">
        <p class="ctv-popup-label">Kinh nghiệm bán hàng :</p>
        <div class="ctv-popup-radio-group">
          <label class="ctv-popup-radio"><input type="radio" name="{{ settings.page_vnl_farmtour_popup_entry_experience }}" value="Chưa có" checked /><span>Chưa có</span></label>
          <label class="ctv-popup-radio"><input type="radio" name="{{ settings.page_vnl_farmtour_popup_entry_experience }}" value="Dưới 6 tháng" /><span>Dưới 6 tháng</span></label>
          <label class="ctv-popup-radio"><input type="radio" name="{{ settings.page_vnl_farmtour_popup_entry_experience }}" value="Trên 6 tháng" /><span>Trên 6 tháng</span></label>
        </div>
      </div>

      <div class="ctv-popup-section">
        <p class="ctv-popup-label">Mục đích tham gia :</p>
        <div class="ctv-popup-checkbox-group">
          <label class="ctv-popup-checkbox"><input type="checkbox" name="{{ settings.page_vnl_farmtour_popup_entry_purpose }}" value="Khách hàng" /><span>Khách hàng</span></label>
          <label class="ctv-popup-checkbox"><input type="checkbox" name="{{ settings.page_vnl_farmtour_popup_entry_purpose }}" value="Đại lý" /><span>Đại lý</span></label>
          <label class="ctv-popup-checkbox"><input type="checkbox" name="{{ settings.page_vnl_farmtour_popup_entry_purpose }}" value="Đối tác" /><span>Đối tác</span></label>
          <label class="ctv-popup-checkbox"><input type="checkbox" name="{{ settings.page_vnl_farmtour_popup_entry_purpose }}" value="Báo chí" /><span>Báo chí</span></label>
          <label class="ctv-popup-checkbox"><input type="checkbox" name="{{ settings.page_vnl_farmtour_popup_entry_purpose }}" value="KOL/KOC" /><span>KOL/KOC</span></label>
        </div>
      </div>

      <div class="ctv-popup-section">
        <p class="ctv-popup-label">Ghi chú</p>
        <textarea name="{{ settings.page_vnl_farmtour_popup_entry_note }}" rows="4" placeholder="Yêu cầu đặc biệt"></textarea>
      </div>

      <button type="submit" class="gu-button ctv-popup-submit">
        <span class="button-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" fill="none">
            <path d="M0.75 9.08333L9.08333 0.75M9.08333 9.08333V0.75H0.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="button-label">{{ settings.page_vnl_farmtour_popup_submit_text }}</span>
      </button>
    </form>
  </div>
</div>

<div class="ctv-success-overlay" data-farmtour-success-overlay aria-hidden="true">
  <div class="ctv-success-popup" role="dialog" aria-modal="true">
    <button type="button" class="ctv-popup-close" data-farmtour-success-close aria-label="Đóng">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
    <div class="ctv-success-icon" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </div>
    <h3>{{ settings.page_vnl_farmtour_popup_success_title }}</h3>
    <p>{{ settings.page_vnl_farmtour_popup_success_message | newline_to_br }}</p>
    <button type="button" class="gu-button" data-farmtour-success-close>
      <span class="button-label">{{ settings.page_vnl_farmtour_popup_success_close_text }}</span>
    </button>
  </div>
</div>

<script defer src="{{ 'vn-units.js' | asset_url }}"></script>
<script defer src="{{ 'popup-farmtour-register.js' | asset_url }}"></script>
