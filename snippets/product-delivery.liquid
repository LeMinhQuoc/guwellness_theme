{%- if settings.product_deliverly_show -%}
<div class="product-delivery">
	{%- for i in (1..3) -%}
		{%- capture delivery_show_key -%}product_deliverly_{{ i }}_show{%- endcapture -%}
		{%- capture delivery_icon_key -%}product_deliverly_{{ i }}_ico{%- endcapture -%}
		{%- capture delivery_text_key -%}product_deliverly_{{ i }}_text{%- endcapture -%}
		{%- assign delivery_show = settings[delivery_show_key] -%}
		{%- assign delivery_icon = settings[delivery_icon_key] -%}
		{%- assign delivery_text = settings[delivery_text_key] -%}
		{%- if delivery_text == blank -%}
			{%- case i -%}
				{%- when 1 -%}{%- assign delivery_text = 'An toàn sức khỏe' -%}
				{%- when 2 -%}{%- assign delivery_text = 'Giao hàng siêu tốc' -%}
				{%- when 3 -%}{%- assign delivery_text = '100% hài lòng khi mua' -%}
			{%- endcase -%}
		{%- endif -%}
		{%- if delivery_show -%}
		<div class="product-delivery-item">
			<span class="product-delivery-icon">
				{%- if delivery_icon != blank -%}
				<img src="{{ delivery_icon }}" alt="" aria-hidden="true"/>
