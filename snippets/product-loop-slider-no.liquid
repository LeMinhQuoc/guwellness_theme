{% comment %}haravan-audit:v2{% endcomment %}
<div class="product-loop">
	<div class="product-inner">
		<div class="proloop-image">
			<div class="pro-sale"><span>-14%</span></div>
			<div class="lazy-img">
				<a href="/adminv2/products_new" title="Tiêu đề sản phẩm {{i}}">
					<img class="lazyload img-loop" src="{{ 'no_image.jpg' | asset_url }}" alt="Tiêu đề sản phẩm {{i}}"  />
				</a>
			</div>
		</div>					
		<div class="proloop-detail">
			<h3>
				<a href="/adminv2/products_new" title="Tiêu đề sản phẩm {{i}}">Tiêu đề sản phẩm {{i}}</a>
			</h3>
			<p class="proloop--price">
				<span class="price">3,150,000₫</span>				
				<span class="price-del">3,650,000₫</span>		
			</p>
		</div>
			<div class="quickview-product">
				<a class="icon-quickview" href="javascript:void(0)" data-handle="{{product.url}}" title="Xem nhanh"><i class="fa fa-eye" aria-hidden="true"></i></a>
			</div>
			<a href="{{product.url}}" class="proloop-link quickview-product" data-handle="{{product.url}}" title="{{product.title}}"></a>
	</div>
</div>





