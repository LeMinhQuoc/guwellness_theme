				$('.checkbox-sortby li').removeClass('active');
				$('.checkbox-sortby li span[data-value="'+ originSort +'"]').parent().addClass('active');
			}
			closeFilterMobile();
		});	
    $(document).on('click','.filter-icon', function(){
      $(this).toggleClass('show');
      $(this).parents('.collection-content').find('.col-filter').toggleClass('show');
      $(this).parents('.collection-content').find('.col-pro').toggleClass('width-full');
